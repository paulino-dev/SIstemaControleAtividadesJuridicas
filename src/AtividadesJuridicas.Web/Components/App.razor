<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="icon" type="image/svg+xml" href="img/simbolo-claro.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@@400;500;600;700&family=Newsreader:opsz,wght@@6..72,500;6..72,600&display=swap" />
    @* Design system: tokens, depois componentes; app.css veste as telas ainda não migradas. *@
    <link rel="stylesheet" href="@Assets["css/tokens.css"]" />
    <link rel="stylesheet" href="@Assets["css/componentes.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["AtividadesJuridicas.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="ModoDaPagina" />
</head>

<body>
    <Routes Ip="@HttpContext.Connection.RemoteIpAddress?.ToString()" @rendermode="ModoDaPagina" />
    <ReconnectModal />

    <div id="blazor-error-ui" data-nosnippet>
        Ocorreu um erro inesperado.
        <a href="." class="reload">Recarregar</a>
        <span class="dismiss">🗙</span>
    </div>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // As páginas de /conta e a de /erro são renderizadas no servidor sem circuito: só assim
    // o HttpContext está disponível para gravar o cookie de autenticação.
    private IComponentRenderMode? ModoDaPagina =>
        PaginaEstatica(HttpContext.Request.Path) ? null : InteractiveServer;

    private static bool PaginaEstatica(PathString caminho) =>
        caminho.StartsWithSegments("/conta") || caminho.StartsWithSegments("/erro");
}
