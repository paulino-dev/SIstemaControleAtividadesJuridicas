<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["AtividadesJuridicas.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="ModoDaPagina" />
</head>

<body>
    <Routes @rendermode="ModoDaPagina" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // As páginas de /conta são renderizadas no servidor sem circuito: só assim
    // o HttpContext está disponível para gravar o cookie de autenticação.
    private IComponentRenderMode? ModoDaPagina =>
        HttpContext.Request.Path.StartsWithSegments("/conta") ? null : InteractiveServer;
}
