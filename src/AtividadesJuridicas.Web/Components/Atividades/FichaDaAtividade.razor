@inject IDespachante Despachante
@inject FusoDoEscritorio Fuso

<section class="ficha">
    @if (_mensagem is not null)
    {
        <p class="@(_falhou ? "erro" : "ok")" role="status">@_mensagem</p>
    }

    @if (!_carregado)
    {
        <p>Carregando…</p>
    }
    else if (_naoEncontrada)
    {
        <p>Atividade não encontrada.</p>
        <div class="acoes"><button type="button" class="secundario" @onclick="FecharAsync">Fechar</button></div>
    }
    else if (_detalhe is not { } a)
    {
        @* Falha ao consultar: nunca é apresentada como uma ficha vazia. *@
        <p class="erro">@(_erroDeCarga ?? "Não foi possível consultar a atividade.")</p>
        <div class="acoes">
            <button type="button" class="secundario" @onclick="TentarDeNovoAsync">Tentar de novo</button>
            <button type="button" class="secundario" @onclick="FecharAsync">Fechar</button>
        </div>
    }
    else
    {
        <h2>@a.Titulo</h2>
        <dl>
            <dt>Situação</dt>
            <dd>
                @RotulosDeAtividade.Status(a.Status)
                @if (a.Atrasada)
                {
                    <strong class="erro">Atrasada</strong>
                }
            </dd>
            <dt>Descrição</dt><dd class="texto-livre">@a.Descricao</dd>
            <dt>Entrega</dt><dd>@RotulosDeAtividade.Data(a.DataEntrega)</dd>
            <dt>Complexidade</dt><dd>@a.Complexidade</dd>
            <dt>Cliente</dt><dd>@a.ClienteNome</dd>
            <dt>Processo</dt><dd>@a.ProcessoTitulo</dd>
            <dt>Área</dt><dd>@a.AreaNome</dd>
            <dt>Autor</dt><dd>@(a.TipoAutor == TipoAutor.Sistema ? "Sistema" : a.AutorNome)</dd>
            <dt>Revisor</dt><dd>@a.RevisorNome</dd>
        </dl>

        <h3>Responsáveis</h3>
        @if (a.Responsaveis.Count == 0)
        {
            <p>Nenhum responsável.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Responsável</th><th>Parte</th><th>Direcionamento</th></tr></thead>
                <tbody>
                    @foreach (var r in a.Responsaveis)
                    {
                        <tr @key="r.UsuarioId">
                            <td>@r.Nome</td>
                            <td>@(r.ConcluidoEm is { } em ? $"Concluída em {Fuso.Formatar(em)}" : "Pendente")</td>
                            @* O direcionamento de outra pessoa nem chega do servidor; aqui só se mostra o que veio, e só se for visível. *@
                            <td class="texto-livre">@(r.DirecionamentoVisivel ? r.Direcionamento : null)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (_painel == Painel.Nenhum)
        {
            <div class="acoes">
                @if (a.Acoes.ConcluirMinhaParte)
                {
                    @if (_confirmando == Confirmacao.Concluir)
                    {
                        <button type="button" disabled="@_ocupado" @onclick="ConcluirMinhaParteAsync">Confirmar: concluir minha parte</button>
                        <button type="button" class="secundario" disabled="@_ocupado" @onclick="CancelarConfirmacao">Cancelar</button>
                    }
                    else
                    {
                        <button type="button" disabled="@_ocupado" @onclick="PedirConclusao">Concluir minha parte</button>
                    }
                }
                @if (a.Acoes.AprovarOuDevolver)
                {
                    @if (_confirmando == Confirmacao.Aprovar)
                    {
                        <button type="button" disabled="@_ocupado" @onclick="AprovarAsync">Confirmar aprovação</button>
                        <button type="button" class="secundario" disabled="@_ocupado" @onclick="CancelarConfirmacao">Cancelar</button>
                    }
                    else
                    {
                        <button type="button" disabled="@_ocupado" @onclick="PedirAprovacao">Aprovar</button>
                    }
                    <button type="button" class="secundario" disabled="@_ocupado" @onclick="AbrirDevolucao">Devolver</button>
                }
                @if (a.Acoes.Reabrir)
                {
                    <button type="button" class="secundario" disabled="@_ocupado" @onclick="AbrirReabertura">Reabrir</button>
                }
                @if (a.Acoes.Editar)
                {
                    <button type="button" class="secundario" disabled="@_ocupado" @onclick="AbrirEdicao">Editar</button>
                }
                @if (a.Acoes.DefinirResponsaveis)
                {
                    <button type="button" class="secundario" disabled="@_ocupado" @onclick="AbrirResponsaveis">Responsáveis</button>
                }
                @if (a.Acoes.TrocarRevisor)
                {
                    <button type="button" class="secundario" disabled="@_ocupado" @onclick="AbrirTrocaDeRevisorAsync">Trocar revisor</button>
                }
                @if (a.Acoes.Excluir)
                {
                    @if (_confirmando == Confirmacao.Excluir)
                    {
                        <button type="button" disabled="@_ocupado" @onclick="ExcluirAsync">Confirmar exclusão</button>
                        <button type="button" class="secundario" disabled="@_ocupado" @onclick="CancelarConfirmacao">Cancelar</button>
                    }
                    else
                    {
                        <button type="button" class="secundario" disabled="@_ocupado" @onclick="PedirExclusao">Excluir</button>
                    }
                }
                <button type="button" class="secundario" disabled="@_ocupado" @onclick="FecharAsync">Fechar</button>
            </div>
        }
        else if (_painel is Painel.Devolver or Painel.Reabrir)
        {
            <div class="formulario">
                <strong>@(_painel == Painel.Devolver ? "Devolver para correção" : "Reabrir atividade")</strong>
                <label>Motivo <textarea rows="3" maxlength="@AtividadeHistoricoStatus.TamanhoMaximoMotivo" @bind="_motivo" disabled="@_ocupado"></textarea></label>
                <fieldset>
                    <legend>Responsáveis que voltam a ter a parte pendente</legend>
                    @foreach (var r in a.Responsaveis)
                    {
                        <label @key="r.UsuarioId">
                            <input type="checkbox" checked="@_marcados.Contains(r.UsuarioId)" disabled="@_ocupado"
                                   @onchange="e => MarcarResponsavel(r.UsuarioId, e)" /> @r.Nome
                        </label>
                    }
                </fieldset>
                <div class="acoes">
                    <button type="button" disabled="@_ocupado" @onclick="ConfirmarDevolucaoOuReaberturaAsync">
                        @(_painel == Painel.Devolver ? "Devolver" : "Reabrir")
                    </button>
                    <button type="button" class="secundario" disabled="@_ocupado" @onclick="FecharPainel">Cancelar</button>
                </div>
            </div>
        }
        else if (_painel == Painel.Revisor)
        {
            <div class="formulario">
                <strong>Trocar revisor</strong>
                <label>
                    Novo revisor
                    <select @bind="_novoRevisorId" disabled="@_ocupado">
                        <option value="@Guid.Empty">Selecione…</option>
                        @foreach (var diretor in _diretores)
                        {
                            <option value="@diretor.Id">@diretor.Nome</option>
                        }
                    </select>
                </label>
                <div class="acoes">
                    <button type="button" disabled="@_ocupado" @onclick="TrocarRevisorAsync">Trocar revisor</button>
                    <button type="button" class="secundario" disabled="@_ocupado" @onclick="FecharPainel">Cancelar</button>
                </div>
            </div>
        }
        else if (_painel == Painel.Responsaveis)
        {
            <EditorDeResponsaveis Atividade="a" OnSalvo="ResponsaveisSalvosAsync" OnConflito="ConflitoAsync"
                                  OnCancelado="FecharPainel" OnAcessoEncerrado="EncerrarAcessoAsync" />
        }
        else if (_painel == Painel.Editar)
        {
            <FormularioDeAtividade AtividadeId="a.Id" Atual="a" OnSalvo="EdicaoSalvaAsync" OnConflito="ConflitoAsync"
                                   OnCancelado="FecharPainel" OnAcessoEncerrado="EncerrarAcessoAsync" />
        }

        <h3>Histórico</h3>
        @if (a.Historico.Count == 0)
        {
            <p>Nenhum registro.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Quando</th><th>Mudança</th><th>Quem</th><th>Motivo</th></tr></thead>
                <tbody>
                    @foreach (var h in a.Historico)
                    {
                        <tr>
                            <td>@Fuso.Formatar(h.DataHora)</td>
                            <td>@(h.StatusAnterior is { } antes ? RotulosDeAtividade.Status(antes) : "—") → @RotulosDeAtividade.Status(h.StatusNovo)</td>
                            <td>@h.UsuarioNome</td>
                            <td class="texto-livre">@h.Motivo</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @* Comentários e documentos não mudam a atividade: não avisam OnMudou nem recarregam a ficha. *@
        <ComentariosDaAtividade @key="@($"comentarios-{a.Id}")" AtividadeId="a.Id" OnAcessoEncerrado="EncerrarAcessoAsync"
                                OnAtividadeNaoEncontrada="RecarregarAsync" />
        @* Gerenciar documentos (renomear e excluir) é permissão da Diretoria, que hoje coincide com poder editar a
           atividade; se as duas regras se separarem, esta linha precisa de uma ação própria. *@
        <DocumentosDaAtividade @key="@($"documentos-{a.Id}")" AtividadeId="a.Id" PodeGerenciar="a.Acoes.Editar"
                               OnAcessoEncerrado="EncerrarAcessoAsync" OnAtividadeNaoEncontrada="RecarregarAsync" />
    }
</section>

@code {
    private enum Painel { Nenhum, Editar, Responsaveis, Devolver, Reabrir, Revisor }

    private enum Confirmacao { Nenhuma, Concluir, Aprovar, Excluir }

    [Parameter, EditorRequired] public Guid AtividadeId { get; set; }

    /// <summary>Avisado quando algo na atividade mudou: a lista da página precisa ser recarregada.</summary>
    [Parameter] public EventCallback OnMudou { get; set; }

    /// <summary>Avisado quando um caso de uso responde acesso negado: a página decide o que mostrar.</summary>
    [Parameter] public EventCallback OnAcessoEncerrado { get; set; }

    [Parameter] public EventCallback OnFechar { get; set; }

    private bool _carregado;
    private bool _naoEncontrada;
    private bool _falhou;
    private bool _ocupado;
    private bool _acessoEncerrado;
    private string? _mensagem;
    private string? _erroDeCarga;
    private AtividadeDetalhe? _detalhe;

    private Painel _painel;
    private Confirmacao _confirmando;
    private string _motivo = string.Empty;
    private HashSet<Guid> _marcados = [];
    private IReadOnlyList<UsuarioResumo> _diretores = [];
    private Guid _novoRevisorId;

    // A versão do registro com que a troca de revisor / a confirmação de exclusão foi aberta.
    private uint _versaoDoPainel;
    private uint _versaoDaConfirmacao;

    protected override async Task OnInitializedAsync()
    {
        await CarregarAsync();
        _carregado = true;
    }

    /// <summary>Consulta a atividade; devolve se a ficha ficou mostrando dados atuais.</summary>
    private async Task<bool> CarregarAsync()
    {
        var resultado = await Despachante.EnviarAsync(new ObterAtividade(AtividadeId));
        _erroDeCarga = null;
        _naoEncontrada = false;
        _acessoEncerrado = false;

        if (resultado.Erro == TipoErro.AcessoNegado)
        {
            await EncerrarAcessoAsync();
            return false;
        }

        if (resultado.Erro == TipoErro.NaoEncontrado)
        {
            // Normal: a atividade foi excluída ou o usuário deixou de enxergá-la.
            _detalhe = null;
            _naoEncontrada = true;
            _painel = Painel.Nenhum;
            return false;
        }

        if (resultado.Valor is not { } detalhe)
        {
            // Dados antigos não ficam na tela depois de uma falha: as ações dependem do que o servidor permite agora.
            _detalhe = null;
            _painel = Painel.Nenhum;
            _erroDeCarga = resultado.Mensagem;
            return false;
        }

        _detalhe = detalhe;
        return true;
    }

    private async Task EncerrarAcessoAsync()
    {
        _acessoEncerrado = true;
        _detalhe = null;
        _painel = Painel.Nenhum;
        _confirmando = Confirmacao.Nenhuma;
        _mensagem = null;
        await OnAcessoEncerrado.InvokeAsync();
    }

    private async Task<bool> EncerradoAsync(Resultado resultado)
    {
        if (resultado.Erro != TipoErro.AcessoNegado) return false;

        await EncerrarAcessoAsync();
        return true;
    }

    private async Task TentarDeNovoAsync()
    {
        if (_ocupado) return;

        _ocupado = true;
        _mensagem = null;
        try
        {
            await CarregarAsync();
        }
        finally
        {
            _ocupado = false;
        }
    }

    /// <summary>Uma seção descobriu que a atividade não existe mais: a ficha relê o registro e mostra o que o servidor diz.</summary>
    private async Task RecarregarAsync() => await CarregarAsync();

    private async Task FecharAsync() => await OnFechar.InvokeAsync();

    private void Avisar(string? mensagem, bool falhou)
    {
        _mensagem = mensagem;
        _falhou = falhou;
    }

    // Métodos, e não lambdas de atribuição, nos @onclick: as confirmações e os painéis têm regras.
    private void PedirConclusao() => _confirmando = Confirmacao.Concluir;

    private void PedirAprovacao() => _confirmando = Confirmacao.Aprovar;

    private void PedirExclusao()
    {
        _versaoDaConfirmacao = _detalhe!.Versao;
        _confirmando = Confirmacao.Excluir;
    }

    private void CancelarConfirmacao() => _confirmando = Confirmacao.Nenhuma;

    private void FecharPainel()
    {
        if (_ocupado) return;
        _mensagem = null;
        _painel = Painel.Nenhum;
    }

    private Task AbrirEdicao() => AbrirPainelAtualizadoAsync(Painel.Editar);

    private Task AbrirResponsaveis() => AbrirPainelAtualizadoAsync(Painel.Responsaveis);

    private Task AbrirDevolucao() => AbrirPainelAtualizadoAsync(Painel.Devolver);

    private Task AbrirReabertura() => AbrirPainelAtualizadoAsync(Painel.Reabrir);

    private Task AbrirTrocaDeRevisorAsync() => AbrirPainelAtualizadoAsync(Painel.Revisor);

    /// <summary>A ação que cada painel executa continua permitida segundo o que o servidor informou agora.</summary>
    private static bool PainelPermitido(Painel painel, AcoesDaAtividade acoes) => painel switch
    {
        Painel.Editar => acoes.Editar,
        Painel.Responsaveis => acoes.DefinirResponsaveis,
        Painel.Devolver => acoes.AprovarOuDevolver,
        Painel.Reabrir => acoes.Reabrir,
        Painel.Revisor => acoes.TrocarRevisor,
        _ => true,
    };

    /// <summary>
    /// Um painel nunca abre em cima de uma foto velha da atividade: o registro é consultado de novo (sob a trava de
    /// uma ação por vez) e o painel só abre se a ação ainda é permitida; senão, só a ficha atualizada aparece.
    /// Os painéis são preenchidos a partir do registro recém-consultado.
    /// </summary>
    private async Task AbrirPainelAtualizadoAsync(Painel painel)
    {
        if (_ocupado || _detalhe is null) return;

        _ocupado = true;
        _mensagem = null;
        _confirmando = Confirmacao.Nenhuma;
        try
        {
            var atualizada = await CarregarAsync();
            if (_acessoEncerrado || !atualizada) return;   // a ficha já mostra o erro, o "não encontrada" ou foi encerrada

            var detalhe = _detalhe!;
            if (!PainelPermitido(painel, detalhe.Acoes))
            {
                _painel = Painel.Nenhum;
                Avisar("A atividade mudou. Confira os dados atualizados.", falhou: true);
                await OnMudou.InvokeAsync();
                return;
            }

            if (painel is Painel.Devolver or Painel.Reabrir)
            {
                _motivo = string.Empty;
                // Todos os responsáveis começam marcados.
                _marcados = [.. detalhe.Responsaveis.Select(r => r.UsuarioId)];
            }
            else if (painel == Painel.Revisor && !await PrepararTrocaDeRevisorAsync(detalhe))
            {
                return;
            }

            _versaoDoPainel = detalhe.Versao;
            _painel = painel;
        }
        finally
        {
            _ocupado = false;
        }
    }

    private void MarcarResponsavel(Guid id, ChangeEventArgs e)
    {
        if (e.Value is true) _marcados.Add(id);
        else _marcados.Remove(id);
    }

    /// <summary>Carrega os diretores ativos para a troca de revisor; devolve se o painel pode abrir.</summary>
    private async Task<bool> PrepararTrocaDeRevisorAsync(AtividadeDetalhe detalhe)
    {
        var usuarios = await Despachante.EnviarAsync(new ListarUsuarios());
        if (await EncerradoAsync(usuarios)) return false;
        if (usuarios.Valor is not { } lista)
        {
            Avisar(usuarios.Mensagem ?? "Não foi possível consultar os usuários.", falhou: true);
            return false;
        }

        _diretores = [.. lista.Where(u => u.Ativo && u.TipoPerfil == TipoPerfil.Diretoria)
            .OrderBy(u => u.Nome, StringComparer.CurrentCultureIgnoreCase)];
        _novoRevisorId = _diretores.Any(d => d.Id == detalhe.RevisorId) ? detalhe.RevisorId!.Value : Guid.Empty;
        return true;
    }

    /// <summary>
    /// Roda uma ação da ficha: um clique duplo não repete, a mensagem anterior some ao começar, e o resultado
    /// decide entre encerrar o acesso, mostrar o erro (recarregando a ficha se ela ficou desatualizada) ou recarregar.
    /// </summary>
    private async Task ExecutarAsync(Func<Task<Resultado>> acao, string sucesso, bool aoTerminarFechar = false)
    {
        if (_ocupado) return;

        _ocupado = true;
        _mensagem = null;
        try
        {
            var resultado = await acao();
            if (await EncerradoAsync(resultado)) return;

            if (!resultado.Sucesso)
            {
                _confirmando = Confirmacao.Nenhuma;
                // Qualquer recusa traz a ficha como está agora, para os botões acompanharem o servidor.
                await RecarregarAposFalhaAsync(
                    resultado.Mensagem, fecharPainel: resultado.Erro is TipoErro.Conflito or TipoErro.NaoEncontrado);
                return;
            }

            _confirmando = Confirmacao.Nenhuma;
            _painel = Painel.Nenhum;

            if (aoTerminarFechar)
            {
                await OnMudou.InvokeAsync();
                await OnFechar.InvokeAsync();
                return;
            }

            var atualizada = await CarregarAsync();
            if (_acessoEncerrado) return;

            Avisar(atualizada ? sucesso : $"{sucesso}, mas não foi possível atualizar a ficha.", falhou: !atualizada);
            await OnMudou.InvokeAsync();
        }
        finally
        {
            _ocupado = false;
        }
    }

    /// <summary>
    /// Uma ação foi recusada: traz a ficha como está agora e mantém o motivo da recusa visível. Num conflito ou
    /// quando a atividade sumiu o painel fecha; numa recusa comum (ex.: validação) ele fica aberto com o que foi
    /// digitado, a não ser que a ação dele já não seja permitida.
    /// </summary>
    private async Task RecarregarAposFalhaAsync(string? mensagem, bool fecharPainel = true)
    {
        if (fecharPainel) _painel = Painel.Nenhum;
        await CarregarAsync();
        if (_acessoEncerrado) return;
        if (_detalhe is not { } atual || !PainelPermitido(_painel, atual.Acoes)) _painel = Painel.Nenhum;

        Avisar(mensagem, falhou: true);
        await OnMudou.InvokeAsync();
    }

    private Task ConcluirMinhaParteAsync() =>
        ExecutarAsync(async () => await Despachante.EnviarAsync(new ConcluirMinhaParte(AtividadeId)), "Sua parte foi concluída.");

    private Task AprovarAsync() =>
        ExecutarAsync(async () => await Despachante.EnviarAsync(new AprovarAtividade(AtividadeId)), "Atividade aprovada.");

    private Task ExcluirAsync()
    {
        var versao = _versaoDaConfirmacao;
        return ExecutarAsync(
            async () => await Despachante.EnviarAsync(new ExcluirAtividade(AtividadeId, versao)), "Atividade excluída.",
            aoTerminarFechar: true);
    }

    private Task TrocarRevisorAsync()
    {
        if (_novoRevisorId == Guid.Empty)
        {
            Avisar("Escolha o novo revisor.", falhou: true);
            return Task.CompletedTask;
        }

        var revisor = _novoRevisorId;
        var versao = _versaoDoPainel;
        return ExecutarAsync(
            async () => await Despachante.EnviarAsync(new TrocarRevisorDaAtividade(AtividadeId, revisor, versao)), "Revisor alterado.");
    }

    private Task ConfirmarDevolucaoOuReaberturaAsync()
    {
        if (_ocupado) return Task.CompletedTask;

        if (string.IsNullOrWhiteSpace(_motivo))
        {
            Avisar("Informe o motivo.", falhou: true);
            return Task.CompletedTask;
        }

        if (_marcados.Count == 0)
        {
            Avisar("Marque ao menos um responsável.", falhou: true);
            return Task.CompletedTask;
        }

        // Só o que está marcado na tela é enviado.
        var motivo = _motivo;
        IReadOnlyList<Guid> responsaveis = [.. _detalhe!.Responsaveis.Where(r => _marcados.Contains(r.UsuarioId)).Select(r => r.UsuarioId)];
        return _painel == Painel.Devolver
            ? ExecutarAsync(async () => await Despachante.EnviarAsync(new DevolverAtividade(AtividadeId, motivo, responsaveis)),
                "Atividade devolvida para correção.")
            : ExecutarAsync(async () => await Despachante.EnviarAsync(new ReabrirAtividade(AtividadeId, motivo, responsaveis)),
                "Atividade reaberta.");
    }

    // Os editores filhos fazem a própria chamada; aqui só se reage ao que eles avisam.
    private Task ResponsaveisSalvosAsync() => FinalizarEdicaoAsync("Responsáveis salvos.");

    private Task EdicaoSalvaAsync(Guid _) => FinalizarEdicaoAsync("Atividade salva.");

    private async Task FinalizarEdicaoAsync(string sucesso)
    {
        // A nova consulta também roda sob a trava: nenhum botão age enquanto a ficha é recarregada.
        _ocupado = true;
        _mensagem = null;
        _painel = Painel.Nenhum;
        try
        {
            var atualizada = await CarregarAsync();
            if (_acessoEncerrado) return;

            Avisar(atualizada ? sucesso : $"{sucesso}, mas não foi possível atualizar a ficha.", falhou: !atualizada);
            await OnMudou.InvokeAsync();
        }
        finally
        {
            _ocupado = false;
        }
    }

    private Task ConflitoAsync(string? mensagem) => RecarregarAposFalhaAsync(mensagem);
}
