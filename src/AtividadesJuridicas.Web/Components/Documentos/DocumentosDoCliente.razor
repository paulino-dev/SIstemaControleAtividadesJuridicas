@inject IDespachante Despachante
@inject FusoDoEscritorio Fuso

<section class="ficha">
    <h3>@Titulo</h3>

    @if (_mensagem is not null)
    {
        <p class="@(_falhou ? "erro" : "ok")" role="status">@_mensagem</p>
    }

    @if (!_carregado)
    {
        <p>Carregando…</p>
    }
    else if (_erroDaLista is not null)
    {
        <p class="erro">@_erroDaLista</p>
        <div class="acoes">
            <button type="button" class="secundario" @onclick="() => IrParaAsync(_paginaPedida)">Tentar de novo</button>
        </div>
    }
    else if (_pagina.Itens.Count == 0)
    {
        <p>Nenhum documento.</p>
    }
    else
    {
        <table>
            <thead>
                <tr><th>Nome</th><th>Tamanho</th><th>Enviado em</th><th>Por</th>@if (DeAtividades)
                    {
                        <th>Atividade</th>
                    }<th></th></tr>
            </thead>
            <tbody>
                @foreach (var documento in _pagina.Itens)
                {
                    <tr @key="documento.Id">
                        <td>
                            @* Link fora da navegação do Blazor: é um download, não uma página. O atributo "download"
                               é o que impede o roteador do Blazor de interceptar o clique; não o remova. *@
                            <a href="@($"/documentos/{documento.Id}/baixar")" download data-enhance-nav="false">@documento.Nome</a>
                        </td>
                        <td>@TamanhoDeArquivo.Formatar(documento.TamanhoBytes)</td>
                        <td>@Fuso.Formatar(documento.EnviadoEm)</td>
                        <td>@documento.EnviadoPor</td>
                        @if (DeAtividades)
                        {
                            <td>@documento.AtividadeTitulo</td>
                        }
                        <td class="acoes">
                            @if (PodeGerenciar)
                            {
                                <button type="button" class="secundario" @onclick="() => AbrirRenomear(documento)">Renomear</button>
                                @if (Categoria == CategoriaDocumento.DocumentoGeral)
                                {
                                    <button type="button" class="secundario" @onclick="() => AbrirAcessoAsync(documento.Id)">Acesso</button>
                                }
                                @if (_excluindo == documento.Id)
                                {
                                    <button type="button" disabled="@_removendo" @onclick="() => ExcluirAsync(documento.Id)">Confirmar exclusão</button>
                                    <button type="button" class="secundario" disabled="@_removendo" @onclick="CancelarExclusao">Cancelar</button>
                                }
                                else
                                {
                                    <button type="button" class="secundario" @onclick="() => PedirExclusao(documento.Id)">Excluir</button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (_pagina.TotalDePaginas > 1)
        {
            <div class="acoes">
                <button type="button" class="secundario" disabled="@(_pagina.Numero <= 1)" @onclick="() => IrParaAsync(_pagina.Numero - 1)">Anterior</button>
                <span>Página @_pagina.Numero de @_pagina.TotalDePaginas</span>
                <button type="button" class="secundario" disabled="@(_pagina.Numero >= _pagina.TotalDePaginas)" @onclick="() => IrParaAsync(_pagina.Numero + 1)">Próxima</button>
            </div>
        }
    }

    @if (PodeGerenciar && _carregado)
    {
        @if (_renomeando is not null)
        {
            <div class="formulario">
                <strong>Renomear "@_renomeando.Nome"</strong>
                <label>Novo nome <input type="text" @bind="_novoNome" /></label>
                <div class="acoes">
                    <button type="button" @onclick="RenomearAsync">Salvar nome</button>
                    <button type="button" class="secundario" @onclick="FecharRenomear">Cancelar</button>
                </div>
            </div>
        }

        @if (_acesso is not null)
        {
            <div class="formulario">
                <strong>Quem acessa "@_acesso.Nome"</strong>
                <p>A Diretoria acessa sempre. Marque os perfis e os usuários que também podem ver este documento; desmarque para retirar.</p>
                <fieldset>
                    <legend>Perfis</legend>
                    @foreach (var perfil in _perfis)
                    {
                        <label @key="perfil.Id">
                            <input type="checkbox" checked="@_perfisMarcados.Contains(perfil.Id)"
                                   @onchange="e => Marcar(_perfisMarcados, perfil.Id, e)" /> @perfil.Rotulo
                        </label>
                    }
                </fieldset>
                <fieldset>
                    <legend>Usuários</legend>
                    @foreach (var usuario in _usuarios)
                    {
                        <label @key="usuario.Id">
                            <input type="checkbox" checked="@_usuariosMarcados.Contains(usuario.Id)"
                                   @onchange="e => Marcar(_usuariosMarcados, usuario.Id, e)" /> @usuario.Rotulo
                        </label>
                    }
                </fieldset>
                <div class="acoes">
                    <button type="button" @onclick="SalvarAcessoAsync">Salvar acesso</button>
                    <button type="button" class="secundario" @onclick="FecharAcesso">Cancelar</button>
                </div>
            </div>
        }

        @* Documento de atividade só nasce na ficha da atividade: aqui não há envio. *@
        @if (!DeAtividades)
        {
            <div class="formulario">
                <strong>Enviar documento</strong>
                <label>Arquivo (até @(DocumentosOpcoes.TamanhoMaximoBytes / UmMegabyte) MB) <InputFile @key="_versaoDoCampo" OnChange="Escolher" /></label>
                <label>Nome (opcional) <input type="text" @bind="_nomeDoEnvio" /></label>
                @if (_confirmacao.AguardandoConfirmacao)
                {
                    <div class="confirmacao" role="alertdialog" aria-label="Confirmar envio" tabindex="-1" @ref="_avisoDeEnvio">
                        <p>Documentos desta área ficam visíveis para todos os clientes do escritório. Não envie aqui arquivos de um cliente específico.</p>
                        <div class="acoes">
                            <button type="button" disabled="@_enviando" @onclick="ConfirmarEnvioAsync">Confirmar envio</button>
                            <button type="button" class="secundario" disabled="@_enviando" @onclick="CancelarEnvio">Cancelar</button>
                        </div>
                    </div>
                }
                <div class="acoes">
                    <button type="button" disabled="@(_arquivo is null || _enviando || _confirmacao.AguardandoConfirmacao)" @onclick="EnviarAsync">
                        @(_enviando ? "Enviando…" : "Enviar")
                    </button>
                </div>
            </div>
        }
    }
</section>

@code {
    private const long UmMegabyte = 1024 * 1024;

    private static readonly Pagina<Linha> Vazia = new([], 0, 1, DocumentosOpcoes.TamanhoDaPagina);

    /// <summary>Nulo só na categoria Documento comum, que não é de cliente nenhum.</summary>
    [Parameter] public Guid? ClienteId { get; set; }
    [Parameter, EditorRequired] public CategoriaDocumento Categoria { get; set; }
    [Parameter, EditorRequired] public string Titulo { get; set; } = string.Empty;
    [Parameter] public bool PodeGerenciar { get; set; }

    /// <summary>Avisado quando um caso de uso responde acesso negado: a página decide o que mostrar.</summary>
    [Parameter] public EventCallback OnAcessoEncerrado { get; set; }

    /// <summary>Documentos de Atividades: coluna "Atividade", sem envio e sem editor de acesso.</summary>
    private bool DeAtividades => Categoria == CategoriaDocumento.DocumentoAtividade;

    private bool _carregado;
    private bool _falhou;
    private bool _enviando;
    private bool _removendo;
    private int _paginaPedida = 1;
    private string? _mensagem;
    private string? _erroDaLista;
    private Pagina<Linha> _pagina = Vazia;

    // Documento comum fica visível a todos os clientes: o envio pede confirmação. Criado em OnInitializedAsync,
    // quando a categoria já chegou.
    private EnvioComConfirmacao _confirmacao = new(exigeConfirmacao: false);
    private ElementReference _avisoDeEnvio;
    private bool _focarAviso;

    private IBrowserFile? _arquivo;
    private string? _nomeDoEnvio;
    private int _versaoDoCampo;

    private Guid? _excluindo;
    private Linha? _renomeando;
    private string _novoNome = string.Empty;

    private AcessoDoDocumento? _acesso;
    private IReadOnlyList<OpcaoDeAcesso> _perfis = [];
    private IReadOnlyList<OpcaoDeAcesso> _usuarios = [];
    private HashSet<Guid> _perfisMarcados = [];
    private HashSet<Guid> _usuariosMarcados = [];

    /// <summary>Uma linha do editor de acesso: tudo o que consta na lista aparece aqui, com caixa de seleção.</summary>
    private sealed record OpcaoDeAcesso(Guid Id, string Rotulo);

    /// <summary>Uma linha da tabela, venha a lista de documentos do cliente ou de documentos comuns.</summary>
    private sealed record Linha(
        Guid Id, string Nome, long TamanhoBytes, DateTime EnviadoEm, string? EnviadoPor, string? AtividadeTitulo);

    protected override async Task OnInitializedAsync()
    {
        // Só o Documento comum não é de um cliente; qualquer outra combinação é erro de quem usa o componente.
        if (Categoria != CategoriaDocumento.DocumentoComum && ClienteId is null)
            throw new InvalidOperationException("Informe o ClienteId: só os Documentos comuns dispensam o cliente.");
        if (Categoria == CategoriaDocumento.DocumentoComum && ClienteId is not null)
            throw new InvalidOperationException("Documentos comuns não pertencem a um cliente: não informe o ClienteId.");

        _confirmacao = new EnvioComConfirmacao(exigeConfirmacao: Categoria == CategoriaDocumento.DocumentoComum);
        await CarregarAsync(1);
        _carregado = true;
    }

    /// <summary>Troca de página ou nova tentativa: o aviso de uma ação anterior não vale mais.</summary>
    private async Task IrParaAsync(int pagina)
    {
        _mensagem = null;
        await CarregarAsync(pagina);
    }

    private async Task CarregarAsync(int pagina)
    {
        _paginaPedida = pagina;
        _excluindo = null;
        Resultado resultado;
        Pagina<Linha>? lida;
        if (Categoria == CategoriaDocumento.DocumentoComum)
        {
            var comuns = await Despachante.EnviarAsync(new ListarDocumentosComuns(pagina));
            resultado = comuns;
            // Documento comum não tem atividade: o título fica nulo. O autor vem preenchido para a Diretoria.
            lida = comuns.Valor is { } p
                ? new Pagina<Linha>([.. p.Itens.Select(d => new Linha(d.Id, d.Nome, d.TamanhoBytes, d.EnviadoEm, d.EnviadoPor, null))],
                    p.Total, p.Numero, p.Tamanho)
                : null;
        }
        else
        {
            var doCliente = await Despachante.EnviarAsync(new ListarDocumentosDoCliente(ClienteId!.Value, Categoria, pagina));
            resultado = doCliente;
            lida = doCliente.Valor is { } p
                ? new Pagina<Linha>([.. p.Itens.Select(d => new Linha(d.Id, d.Nome, d.TamanhoBytes, d.EnviadoEm, d.EnviadoPor, d.AtividadeTitulo))],
                    p.Total, p.Numero, p.Tamanho)
                : null;
        }

        if (await EncerradoAsync(resultado)) return;

        _pagina = lida ?? Vazia;
        // Falha na consulta não é "nenhum documento": mostra o erro no lugar da lista.
        _erroDaLista = resultado.Sucesso ? null : resultado.Mensagem ?? "Não foi possível consultar os documentos.";

        // A página ficou além do fim (por exemplo, ao excluir o único item dela): volta à última.
        if (resultado.Sucesso && _pagina.Itens.Count == 0 && _pagina.Total > 0 && _pagina.Numero > _pagina.TotalDePaginas)
            await CarregarAsync(_pagina.TotalDePaginas);
    }

    private async Task<bool> EncerradoAsync(Resultado resultado)
    {
        if (resultado.Erro != TipoErro.AcessoNegado) return false;

        _pagina = Vazia;
        _acesso = null;
        _renomeando = null;
        _confirmacao.Cancelar();
        await OnAcessoEncerrado.InvokeAsync();
        return true;
    }

    private void Escolher(InputFileChangeEventArgs e)
    {
        // Cancelar o diálogo de arquivos dispara a troca com zero arquivos.
        _arquivo = e.FileCount > 0 ? e.File : null;
        _mensagem = null;
        // O aviso era sobre o arquivo anterior.
        _confirmacao.Cancelar();
    }

    /// <summary>Clique em "Enviar": nos Documentos comuns só abre o aviso; nas demais categorias envia direto.</summary>
    private async Task EnviarAsync()
    {
        if (_arquivo is not { } arquivo || _enviando || _confirmacao.AguardandoConfirmacao) return;

        _mensagem = null;
        // O aviso só abre para um envio que pode seguir. O arquivo não muda com o aviso aberto (escolher outro o
        // fecha), então a confirmação não repete esta verificação.
        if (arquivo.Size > DocumentosOpcoes.TamanhoMaximoBytes)
        {
            Avisar($"O arquivo passa do limite de {DocumentosOpcoes.TamanhoMaximoBytes / UmMegabyte} MB.", falhou: true);
            return;
        }

        if (!_confirmacao.Pedir())
        {
            _focarAviso = true;
            return;
        }

        await EnviarArquivoAsync(confirmou: false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focarAviso) return;

        _focarAviso = false;
        try
        {
            await _avisoDeEnvio.FocusAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSException or JSDisconnectedException)
        {
            // Sem foco (circuito caindo, por exemplo) o aviso continua visível e funcional.
        }
    }

    private async Task ConfirmarEnvioAsync()
    {
        if (_arquivo is null || _enviando) return;

        if (!_confirmacao.Confirmar()) return;

        await EnviarArquivoAsync(confirmou: true);
    }

    // O arquivo e o nome escolhidos ficam: o usuário pode enviar depois.
    private void CancelarEnvio() => _confirmacao.Cancelar();

    private async Task EnviarArquivoAsync(bool confirmou)
    {
        if (_arquivo is not { } arquivo || _enviando) return;

        _mensagem = null;
        _enviando = true;
        try
        {
            await using var conteudo = arquivo.OpenReadStream(DocumentosOpcoes.TamanhoMaximoBytes);
            Resultado<Guid> resultado = Categoria == CategoriaDocumento.DocumentoComum
                ? await Despachante.EnviarAsync(new EnviarDocumentoComum(
                    _nomeDoEnvio, arquivo.Name, arquivo.ContentType, conteudo, ConfirmouVisibilidade: confirmou))
                : await Despachante.EnviarAsync(new EnviarDocumento(
                    Categoria, ClienteId!.Value, _nomeDoEnvio, arquivo.Name, arquivo.ContentType, conteudo));
            if (await EncerradoAsync(resultado)) return;

            if (!resultado.Sucesso)
            {
                Avisar(resultado.Mensagem, falhou: true);
                return;
            }

            // Se outro arquivo foi escolhido enquanto este subia, a escolha nova é preservada.
            if (ReferenceEquals(_arquivo, arquivo))
            {
                _arquivo = null;
                _nomeDoEnvio = null;
                _versaoDoCampo++;   // recria o campo de arquivo, vazio
            }

            await CarregarAsync(1);
            if (_erroDaLista is null) Avisar("Documento enviado.", falhou: false);
            else Avisar("Documento enviado, mas não foi possível atualizar a lista.", falhou: true);
        }
        catch (Exception ex) when (ex is IOException or JSException or TimeoutException or OperationCanceledException)
        {
            // A leitura do arquivo no navegador foi interrompida (conexão caiu, arquivo removido, tempo esgotado).
            Avisar("Não foi possível enviar o arquivo. Escolha-o de novo e tente outra vez.", falhou: true);
        }
        finally
        {
            _enviando = false;
        }
    }

    private void AbrirRenomear(Linha documento)
    {
        _mensagem = null;
        _acesso = null;
        _renomeando = documento;
        _novoNome = documento.Nome;
    }

    private async Task RenomearAsync()
    {
        if (_renomeando is not { } documento) return;

        _mensagem = null;
        var resultado = await Despachante.EnviarAsync(new RenomearDocumento(documento.Id, _novoNome));
        if (await EncerradoAsync(resultado)) return;

        if (!resultado.Sucesso)
        {
            Avisar(resultado.Mensagem, falhou: true);
            return;
        }

        if (ReferenceEquals(_renomeando, documento)) _renomeando = null;
        await CarregarAsync(_pagina.Numero);
        if (_erroDaLista is null) Avisar("Nome alterado.", falhou: false);
        else Avisar("Nome alterado, mas não foi possível atualizar a lista.", falhou: true);
    }

    // Métodos, e não lambdas de atribuição, nos @onclick: a exclusão pede um segundo clique.
    private void PedirExclusao(Guid id) => _excluindo = id;

    private void CancelarExclusao() => _excluindo = null;

    private void FecharRenomear() => _renomeando = null;

    private void FecharAcesso() => _acesso = null;

    private async Task ExcluirAsync(Guid id)
    {
        // Um segundo clique em "Confirmar exclusão" receberia "não encontrado" e apagaria o aviso de sucesso.
        if (_removendo) return;

        _removendo = true;
        _mensagem = null;
        try
        {
            var resultado = await Despachante.EnviarAsync(new ExcluirDocumento(id));
            if (await EncerradoAsync(resultado)) return;

            if (!resultado.Sucesso)
            {
                Avisar(resultado.Mensagem, falhou: true);
                return;
            }

            if (_acesso?.DocumentoId == id) _acesso = null;
            if (_renomeando?.Id == id) _renomeando = null;
            await CarregarAsync(_pagina.Numero);
            if (_erroDaLista is null) Avisar("Documento excluído.", falhou: false);
            else Avisar("Documento excluído, mas não foi possível atualizar a lista.", falhou: true);
        }
        finally
        {
            _removendo = false;
            _excluindo = null;
        }
    }

    private async Task AbrirAcessoAsync(Guid id)
    {
        _mensagem = null;
        _renomeando = null;

        var acesso = await Despachante.EnviarAsync(new ObterAcessoDoDocumento(id));
        if (await EncerradoAsync(acesso)) return;
        var perfis = await Despachante.EnviarAsync(new ListarPerfis());
        if (await EncerradoAsync(perfis)) return;
        var usuarios = await Despachante.EnviarAsync(new ListarUsuarios());
        if (await EncerradoAsync(usuarios)) return;

        if (acesso.Valor is null || perfis.Valor is null || usuarios.Valor is null)
        {
            Avisar(acesso.Mensagem ?? perfis.Mensagem ?? usuarios.Mensagem, falhou: true);
            return;
        }

        // Tudo o que consta na lista aparece com uma caixa que funciona, para poder ser retirado; e só o que
        // aparece é enviado ao salvar. Perfis ativos e usuários ativos de Produção são as opções para incluir;
        // um perfil inativo só aparece se já consta na lista (o domínio recusaria incluí-lo), identificado como tal.
        var naLista = acesso.Valor.Perfis.ToHashSet();
        var perfisDaTela = new List<OpcaoDeAcesso>(perfis.Valor.Where(p => p.Tipo != TipoPerfil.Cliente && (p.Ativo || naLista.Contains(p.Id)))
            .Select(p => new OpcaoDeAcesso(p.Id, RotuloDoPerfil(p))));
        perfisDaTela.AddRange(naLista.Where(perfilId => perfisDaTela.All(o => o.Id != perfilId))
            .Select(perfilId => new OpcaoDeAcesso(perfilId, "Perfil não identificado")));

        var usuariosDaTela = new List<OpcaoDeAcesso>(usuarios.Valor.Where(u => u.Ativo && u.TipoPerfil == TipoPerfil.Producao)
            .Select(u => new OpcaoDeAcesso(u.Id, $"{u.Nome} ({u.PerfilNome})")));
        foreach (var usuarioId in acesso.Valor.Usuarios.Where(uid => usuariosDaTela.All(o => o.Id != uid)))
        {
            var usuario = usuarios.Valor.FirstOrDefault(u => u.Id == usuarioId);
            usuariosDaTela.Add(new OpcaoDeAcesso(usuarioId, usuario is null
                ? "Usuário não identificado"
                : $"{usuario.Nome} ({(usuario.Ativo ? "Diretoria — acessa sempre" : "inativo")})"));
        }

        _perfis = perfisDaTela;
        _usuarios = usuariosDaTela;
        _perfisMarcados = [.. acesso.Valor.Perfis];
        _usuariosMarcados = [.. acesso.Valor.Usuarios];
        _acesso = acesso.Valor;
    }

    private static string RotuloDoPerfil(PerfilDetalhe perfil) =>
        !perfil.Ativo ? $"{perfil.Nome} (inativo)"
        : perfil.Tipo == TipoPerfil.Diretoria ? $"{perfil.Nome} (Diretoria — acessa sempre)"
        : perfil.Nome;

    private static void Marcar(HashSet<Guid> marcados, Guid id, ChangeEventArgs e)
    {
        if (e.Value is true) marcados.Add(id);
        else marcados.Remove(id);
    }

    private async Task SalvarAcessoAsync()
    {
        if (_acesso is not { } acesso) return;

        _mensagem = null;
        var resultado = await Despachante.EnviarAsync(
            new DefinirAcessoDoDocumento(acesso.DocumentoId, [.. _perfisMarcados], [.. _usuariosMarcados]));
        if (await EncerradoAsync(resultado)) return;

        if (!resultado.Sucesso)
        {
            Avisar(resultado.Mensagem, falhou: true);
            return;
        }

        if (_acesso?.DocumentoId == acesso.DocumentoId) _acesso = null;
        Avisar("Acesso atualizado.", falhou: false);
    }

    private void Avisar(string? mensagem, bool falhou)
    {
        _mensagem = mensagem;
        _falhou = falhou;
    }
}
