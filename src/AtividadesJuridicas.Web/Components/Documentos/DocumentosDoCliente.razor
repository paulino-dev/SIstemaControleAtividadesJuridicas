@inherits GestaoDeDocumentos
@inject FusoDoEscritorio Fuso

<section class="ficha">
    <h3>@Titulo</h3>

    @if (_mensagem is not null)
    {
        <p class="@(_falhou ? "erro" : "ok")" role="status">@_mensagem</p>
    }

    @if (!_carregado)
    {
        <p>Carregando…</p>
    }
    else if (_erroDaLista is not null)
    {
        <p class="erro">@_erroDaLista</p>
        <div class="acoes">
            <button type="button" class="secundario" @onclick="() => IrParaAsync(_paginaPedida)">Tentar de novo</button>
        </div>
    }
    else if (_pagina.Itens.Count == 0)
    {
        <p>Nenhum documento.</p>
    }
    else
    {
        <table>
            <thead>
                <tr><th>Nome</th><th>Tamanho</th><th>Enviado em</th><th>Por</th>@if (DeAtividades)
                    {
                        <th>Atividade</th>
                    }<th></th></tr>
            </thead>
            <tbody>
                @foreach (var documento in _pagina.Itens)
                {
                    <tr @key="documento.Id">
                        <td>
                            @* Link fora da navegação do Blazor: é um download, não uma página. O atributo "download"
                               é o que impede o roteador do Blazor de interceptar o clique; não o remova. *@
                            <a href="@($"/documentos/{documento.Id}/baixar")" download data-enhance-nav="false">@documento.Nome</a>
                        </td>
                        <td>@TamanhoDeArquivo.Formatar(documento.TamanhoBytes)</td>
                        <td>@Fuso.Formatar(documento.EnviadoEm)</td>
                        <td>@documento.EnviadoPor</td>
                        @if (DeAtividades)
                        {
                            <td>@documento.AtividadeTitulo</td>
                        }
                        <td class="acoes">
                            @if (PodeGerenciar)
                            {
                                <button type="button" class="secundario" @onclick="() => AbrirRenomear(documento)">Renomear</button>
                                @if (Categoria == CategoriaDocumento.DocumentoGeral)
                                {
                                    <button type="button" class="secundario" @onclick="() => AbrirAcessoAsync(documento.Id)">Acesso</button>
                                }
                                @if (_excluindo == documento.Id)
                                {
                                    <button type="button" disabled="@_removendo" @onclick="() => ExcluirAsync(documento.Id)">Confirmar exclusão</button>
                                    <button type="button" class="secundario" disabled="@_removendo" @onclick="CancelarExclusao">Cancelar</button>
                                }
                                else
                                {
                                    <button type="button" class="secundario" @onclick="() => PedirExclusao(documento.Id)">Excluir</button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (_pagina.TotalDePaginas > 1)
        {
            <div class="acoes">
                <button type="button" class="secundario" disabled="@(_pagina.Numero <= 1)" @onclick="() => IrParaAsync(_pagina.Numero - 1)">Anterior</button>
                <span>Página @_pagina.Numero de @_pagina.TotalDePaginas</span>
                <button type="button" class="secundario" disabled="@(_pagina.Numero >= _pagina.TotalDePaginas)" @onclick="() => IrParaAsync(_pagina.Numero + 1)">Próxima</button>
            </div>
        }
    }

    @if (PodeGerenciar && _carregado)
    {
        @if (_renomeando is not null)
        {
            <div class="formulario">
                <strong>Renomear "@_renomeando.Nome"</strong>
                <label>Novo nome <input type="text" @bind="_novoNome" /></label>
                <div class="acoes">
                    <button type="button" @onclick="RenomearAsync">Salvar nome</button>
                    <button type="button" class="secundario" @onclick="FecharRenomear">Cancelar</button>
                </div>
            </div>
        }

        @if (_acesso is not null)
        {
            <div class="formulario">
                <strong>Quem acessa "@_acesso.Nome"</strong>
                <p>A Diretoria acessa sempre. Marque os perfis e os usuários que também podem ver este documento; desmarque para retirar.</p>
                <fieldset>
                    <legend>Perfis</legend>
                    @foreach (var perfil in _perfis)
                    {
                        <label @key="perfil.Id">
                            <input type="checkbox" checked="@_perfisMarcados.Contains(perfil.Id)"
                                   @onchange="e => Marcar(_perfisMarcados, perfil.Id, e)" /> @perfil.Rotulo
                        </label>
                    }
                </fieldset>
                <fieldset>
                    <legend>Usuários</legend>
                    @foreach (var usuario in _usuarios)
                    {
                        <label @key="usuario.Id">
                            <input type="checkbox" checked="@_usuariosMarcados.Contains(usuario.Id)"
                                   @onchange="e => Marcar(_usuariosMarcados, usuario.Id, e)" /> @usuario.Rotulo
                        </label>
                    }
                </fieldset>
                <div class="acoes">
                    <button type="button" @onclick="SalvarAcessoAsync">Salvar acesso</button>
                    <button type="button" class="secundario" @onclick="FecharAcesso">Cancelar</button>
                </div>
            </div>
        }

        @* Documento de atividade só nasce na ficha da atividade: aqui não há envio. *@
        @if (!DeAtividades)
        {
            <div class="formulario">
                <strong>Enviar documento</strong>
                <label>Arquivo (até @(DocumentosOpcoes.TamanhoMaximoBytes / UmMegabyte) MB) <InputFile @key="_versaoDoCampo" OnChange="Escolher" /></label>
                <label>Nome (opcional) <input type="text" @bind="_nomeDoEnvio" /></label>
                @if (_confirmacao.AguardandoConfirmacao)
                {
                    <div class="confirmacao" role="alertdialog" aria-label="Confirmar envio" tabindex="-1" @ref="_avisoDeEnvio">
                        <p>Documentos desta área ficam visíveis para todos os clientes do escritório. Não envie aqui arquivos de um cliente específico.</p>
                        <div class="acoes">
                            <button type="button" disabled="@_enviando" @onclick="ConfirmarEnvioAsync">Confirmar envio</button>
                            <button type="button" class="secundario" disabled="@_enviando" @onclick="CancelarEnvio">Cancelar</button>
                        </div>
                    </div>
                }
                <div class="acoes">
                    <button type="button" disabled="@(_arquivo is null || _enviando || _confirmacao.AguardandoConfirmacao)" @onclick="EnviarAsync">
                        @(_enviando ? "Enviando…" : "Enviar")
                    </button>
                </div>
            </div>
        }
    }
</section>

@code {
    /// <summary>Nulo só na categoria Documento comum, que não é de cliente nenhum.</summary>
    [Parameter] public Guid? ClienteId { get; set; }
    [Parameter, EditorRequired] public CategoriaDocumento Categoria { get; set; }
    [Parameter, EditorRequired] public string Titulo { get; set; } = string.Empty;
    [Parameter] public bool PodeGerenciar { get; set; }

    private ElementReference _avisoDeEnvio;

    protected override CategoriaDocumento CategoriaDosDocumentos => Categoria;
    protected override Guid? ClienteDosDocumentos => ClienteId;
    protected override ValueTask FocarAvisoDeEnvioAsync() => _avisoDeEnvio.FocusAsync();

    // Este componente mantém o campo de envio sempre à vista: nada a fechar ao concluir (a Tarefa 7 o substitui).
    protected override void AoConcluirEnvio() { }
}
