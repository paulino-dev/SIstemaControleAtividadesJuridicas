@using Microsoft.AspNetCore.Components.Sections

@* Cabeçalho de página do design system. Emite as duas formas e o CSS mostra a da visão atual: no desktop e no
   tablet, o aj-cabecalho dentro do conteúdo; no mobile, a barra superior da tela, no encaixe do layout.
   Com VoltarPara, a barra do mobile é a de voltar (ficha e formulário), e a barra inferior some.
   Com Acao, a ação principal da tela: botão primário no cabeçalho e, no mobile, botão flutuante.
   Dois encaixes: Complemento, ao lado do título no desktop e no tablet (um controle segmentado, antes da ação), e
   LinhaDoMobile, a segunda linha da barra superior do mobile (busca, chips, controle segmentado). *@
@if (VoltarPara is not null)
{
    <BarraDeVoltar Titulo="@Titulo" VoltarPara="@VoltarPara" Rotulo="@(RotuloDoVoltar ?? "Voltar")" />
}
else
{
    <SectionContent SectionName="@Encaixes.BarraSuperior">
        <header class="aj-barra-superior">
            <div class="aj-barra-superior__linha">
                <img src="img/simbolo-claro.svg" alt="Araújo Advocacia" width="24" height="27" />
                <div class="aj-barra-superior__titulo">
                    <h1 class="aj-titulo">@Titulo</h1>
                    @if (SubtituloDaBarra is { } subtituloMobile)
                    {
                        <span class="aj-subtitulo">@subtituloMobile@ParteDoAlerta</span>
                    }
                </div>
                <a href="/minha-senha" class="aj-avatar" aria-label="Minha conta">@Contexto?.Iniciais</a>
            </div>
            @LinhaDoMobile
        </header>
    </SectionContent>
}

<div class="aj-desktop-tablet">
    <header class="aj-cabecalho">
        <div class="aj-cabecalho__inicio">
            <span class="aj-cabecalho__menu">
                <button type="button" class="aj-botao aj-botao--secundario aj-botao--icone" aria-label="Exibir menu" @onclick="ExibirMenuAsync"><Icone Nome="menu" /></button>
                <img src="img/simbolo-claro.svg" alt="Araújo Advocacia" width="29" height="32" />
            </span>
            <div class="@(Folgado ? "aj-cabecalho__texto aj-cabecalho__texto--folgado" : "aj-cabecalho__texto")">
                <h1 class="aj-titulo">@Titulo</h1>
                @if (Subtitulo is not null)
                {
                    <p class="aj-subtitulo">@Subtitulo@ParteDoAlerta</p>
                }
            </div>
        </div>
        @Complemento
        @if (Acao is not null)
        {
            @if (AcaoHref is not null)
            {
                <a href="@AcaoHref" class="aj-botao aj-botao--primario aj-botao--com-icone"><Icone Nome="@IconeDaAcao" />@Acao</a>
            }
            else
            {
                <button type="button" class="aj-botao aj-botao--primario aj-botao--com-icone" @onclick="OnAcao"><Icone Nome="@IconeDaAcao" />@Acao</button>
            }
        }
    </header>
</div>

@if (Acao is not null)
{
    @if (AcaoHref is not null)
    {
        <a href="@AcaoHref" class="aj-fab" aria-label="@Acao"><Icone Nome="@IconeDaAcao" /></a>
    }
    else
    {
        <button type="button" class="aj-fab" aria-label="@Acao" @onclick="OnAcao"><Icone Nome="@IconeDaAcao" /></button>
    }
}

@code {
    [CascadingParameter] private ContextoDoLayout? Contexto { get; set; }

    [Parameter, EditorRequired] public string Titulo { get; set; } = string.Empty;

    /// <summary>A linha de contexto sob o título, no desktop e no tablet.</summary>
    [Parameter] public string? Subtitulo { get; set; }

    /// <summary>
    /// A linha de contexto da barra superior do mobile, quando o quadro a encurta. Nula, vale <see cref="Subtitulo"/>;
    /// vazia, a barra do mobile fica sem subtítulo.
    /// </summary>
    [Parameter] public string? SubtituloMobile { get; set; }

    /// <summary>
    /// A parte de alerta do subtítulo ("1 atrasada"), depois de um " · ", num strong que o design system pinta de
    /// vermelho no tablet e no mobile. O <see cref="Subtitulo"/> leva só a primeira parte ("8 atividades").
    /// </summary>
    [Parameter] public string? Alerta { get; set; }

    /// <summary>Subtítulo em frase: o quadro afasta um pouco mais o título.</summary>
    [Parameter] public bool Folgado { get; set; }

    /// <summary>Destino do voltar da barra superior do mobile. Informado, a barra é a de voltar.</summary>
    [Parameter] public string? VoltarPara { get; set; }

    /// <summary>O rótulo acessível do voltar: "Voltar para Início". Sem ele, o botão diz só "Voltar".</summary>
    [Parameter] public string? RotuloDoVoltar { get; set; }

    /// <summary>A ação principal da tela: botão no cabeçalho do desktop e do tablet, botão flutuante no mobile.</summary>
    [Parameter] public string? Acao { get; set; }

    /// <summary>O ícone da ação principal.</summary>
    [Parameter] public string IconeDaAcao { get; set; } = "adicionar";

    /// <summary>Destino da ação principal quando ela leva a outra tela. Sem ele, a ação chama <see cref="OnAcao"/>.</summary>
    [Parameter] public string? AcaoHref { get; set; }

    [Parameter] public EventCallback OnAcao { get; set; }

    /// <summary>O que fica ao lado do título no desktop e no tablet, no lugar ou antes da ação (um controle segmentado).</summary>
    [Parameter] public RenderFragment? Complemento { get; set; }

    /// <summary>A segunda linha da barra superior do mobile (busca, chips, controle segmentado).</summary>
    [Parameter] public RenderFragment? LinhaDoMobile { get; set; }

    private string? SubtituloDaBarra =>
        SubtituloMobile is null ? Subtitulo : SubtituloMobile.Length == 0 ? null : SubtituloMobile;

    // O separador vai como texto do próprio fragmento: escrito na marcação, o compilador do Razor poderia aparar o
    // espaço da ponta. Sem alerta, nada é emitido e o subtítulo fica como era.
    private RenderFragment ParteDoAlerta => construtor =>
    {
        if (Alerta is null) return;

        construtor.AddContent(0, " · ");
        construtor.OpenElement(1, "strong");
        construtor.AddAttribute(2, "class", "aj-subtitulo__alerta");
        construtor.AddContent(3, Alerta);
        construtor.CloseElement();
    };

    private Task ExibirMenuAsync() => Contexto is { } contexto ? contexto.AlternarMenu.InvokeAsync() : Task.CompletedTask;
}
