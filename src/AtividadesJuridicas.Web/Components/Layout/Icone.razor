    /// <summary>Nome do ícone no design system (grupo Icones): "inicio", "agenda", "sair"…</summary>
    [Parameter, EditorRequired] public string Nome { get; set; } = string.Empty;

    /// <summary>Classe do design system para o ícone solto (fora de menu e de botão), que traz tamanho e cor.</summary>
    [Parameter] public string? Classe { get; set; }

    // Os três pontos são preenchidos; os demais ícones são de traço.
    private string? ClasseDoIcone => Nome == "mais"
        ? (Classe is null ? "aj-icone-cheio" : $"{Classe} aj-icone-cheio")
