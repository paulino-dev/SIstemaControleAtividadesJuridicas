@inherits LayoutComponentBase
@using AtividadesJuridicas.Web.Components.Pages
@inject IDespachante Despachante
@inject NavigationManager Navegacao

<header class="topo">
    <a class="marca" href="/">Atividades Jurídicas</a>
    <nav>
        <NavLink href="/" Match="NavLinkMatch.All">Início</NavLink>
        @if (EhCliente)
        {
            <NavLink href="/meus-documentos">Meus documentos</NavLink>
            <NavLink href="/documentos-comuns">Documentos comuns</NavLink>
        }
        else
        {
            <NavLink href="/atividades">Atividades</NavLink>
            <NavLink href="/agenda">Agenda</NavLink>
            <NavLink href="/clientes">Clientes</NavLink>
            <NavLink href="/processos">Processos</NavLink>
            @if (_ator is { EhDiretoria: true })
            {
                <NavLink href="/documentos-comuns">Documentos comuns</NavLink>
                <NavLink href="/areas">Áreas</NavLink>
                <NavLink href="/usuarios">Usuários</NavLink>
                <NavLink href="/produtores">Produtores</NavLink>
                <NavLink href="/perfis">Perfis</NavLink>
                <NavLink href="/auditoria">Auditoria</NavLink>
            }
        }
        <NavLink href="/minha-senha">Minha senha</NavLink>
    </nav>
    <span class="quem">@_ator?.Nome</span>
    <form method="post" action="/conta/sair">
        <AntiforgeryToken />
        <button type="submit">Sair</button>
    </form>
</header>

<main class="conteudo">
    @if (!_marcaLida)
    {
        <p>Carregando…</p>
    }
    else if (EhCliente ? !RotasDoCliente.Permite(Rota) : RotasDoCliente.Exclusiva(Rota))
    {
        @* A página não é montada: ela não chega a consultar nada. *@
        <NaoEncontrada />
    }
    else
    {
        @Body
    }
</main>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? EstadoDeAutenticacao { get; set; }

    private UsuarioAutenticado? _ator;
    private bool _marcaLida;
    private bool _portalPeloCookie;

    // O banco manda quando já respondeu; antes disso, e se o acesso foi encerrado, vale a marca do cookie.
    private bool EhCliente => _ator?.EhCliente ?? _portalPeloCookie;

    private string Rota => Navegacao.ToBaseRelativePath(Navegacao.Uri);

    protected override async Task OnInitializedAsync()
    {
        // A tarefa do estado de autenticação já vem concluída: a marca é lida antes da primeira renderização.
        if (EstadoDeAutenticacao is not null)
            _portalPeloCookie = IdentidadeHttp.EhDoPortal((await EstadoDeAutenticacao).User);
        _marcaLida = true;

        _ator = await Despachante.EnviarAsync(new ObterMeuAcesso());
    }
}
