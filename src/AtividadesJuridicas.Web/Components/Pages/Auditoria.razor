@page "/auditoria"
@inject IDespachante Despachante
@inject FusoDoEscritorio Fuso

<PageTitle>Auditoria</PageTitle>

<CabecalhoDePagina Titulo="Auditoria" Subtitulo="@Subtitulo">
    <Complemento>@if (_autorizado) { @Segmentado }</Complemento>
    <LinhaDoMobile>@if (_autorizado) { @Segmentado }</LinhaDoMobile>
</CabecalhoDePagina>

@if (!_carregado)
{
    <p class="aj-subtitulo" role="status">Carregando…</p>
}
else if (!_autorizado)
{
    <Aviso Tipo="TipoDeAviso.Erro">Acesso negado.</Aviso>
}
else
{
    <div class="aj-so-desktop">
        @if (_aba == Aba.Alteracoes)
        {
            <form class="aj-barra-filtros" role="search" @onsubmit="FiltrarAsync" @onsubmit:preventDefault>
                <label class="aj-campo-filtro aj-campo-filtro--data"><span>De</span><input type="date" class="aj-campo-filtro__controle" @bind="_filtro.De" /></label>
                <label class="aj-campo-filtro aj-campo-filtro--data"><span>Até</span><input type="date" class="aj-campo-filtro__controle" @bind="_filtro.Ate" /></label>
                <label class="aj-campo-filtro"><span>Usuário</span><select class="aj-campo-filtro__controle" @bind="_filtro.UsuarioId"><option value="">Todos</option>@foreach (var usuario in _usuarios) { <option value="@usuario.Id">@usuario.Nome</option> }</select></label>
                <label class="aj-campo-filtro"><span>Operação</span><select class="aj-campo-filtro__controle" @bind="_filtro.Operacao"><option value="">Todas</option><option value="@OperacaoAuditada.Criacao">Criação</option><option value="@OperacaoAuditada.Alteracao">Alteração</option><option value="@OperacaoAuditada.Exclusao">Exclusão</option><option value="@OperacaoAuditada.Evento">Evento</option></select></label>
                <label class="aj-campo-filtro aj-campo-filtro--texto"><span>Entidade</span><input type="text" class="aj-campo-filtro__controle" placeholder="Usuario, Perfil…" @bind="_filtro.Entidade" /></label>
                <label class="aj-campo-filtro aj-campo-filtro--identificador"><span>Registro</span><input type="text" class="aj-campo-filtro__controle" placeholder="Identificador do registro" @bind="_filtro.EntidadeId" /></label>
                <label class="aj-campo-filtro aj-campo-filtro--identificador"><span>Gravação</span><input type="text" class="aj-campo-filtro__controle" placeholder="Identificador de correlação" @bind="_filtro.IdCorrelacao" /></label>
                <button type="submit" class="aj-botao aj-botao--secundario">Filtrar</button>
            </form>
        }
        else
        {
            <form class="aj-barra-filtros" role="search" @onsubmit="FiltrarAsync" @onsubmit:preventDefault>
                <label class="aj-campo-filtro aj-campo-filtro--data"><span>De</span><input type="date" class="aj-campo-filtro__controle" @bind="_filtro.De" /></label>
                <label class="aj-campo-filtro aj-campo-filtro--data"><span>Até</span><input type="date" class="aj-campo-filtro__controle" @bind="_filtro.Ate" /></label>
                <label class="aj-campo-filtro"><span>Usuário</span><select class="aj-campo-filtro__controle" @bind="_filtro.UsuarioId"><option value="">Todos</option>@foreach (var usuario in _usuarios) { <option value="@usuario.Id">@usuario.Nome</option> }</select></label>
                <label class="aj-campo-filtro"><span>Ação</span><select class="aj-campo-filtro__controle" @bind="_filtro.Acao"><option value="">Todas</option><option value="@AcaoDeAcesso.Listou">Listou</option><option value="@AcaoDeAcesso.Visualizou">Visualizou</option><option value="@AcaoDeAcesso.Baixou">Baixou</option></select></label>
                <label class="aj-campo-filtro aj-campo-filtro--texto"><span>Recurso</span><input type="text" class="aj-campo-filtro__controle" placeholder="Usuario, RegistroAuditoria…" @bind="_filtro.TipoRecurso" /></label>
                <button type="submit" class="aj-botao aj-botao--secundario">Filtrar</button>
            </form>
        }
    </div>

    <div class="aj-tablet-mobile">
        <form class="aj-linha-filtros" role="search" @onsubmit="FiltrarAsync" @onsubmit:preventDefault>
            <label class="aj-campo-filtro aj-campo-filtro--data"><span>De</span><input type="date" class="aj-campo-filtro__controle" @bind="_filtro.De" /></label>
            <label class="aj-campo-filtro aj-campo-filtro--data"><span>Até</span><input type="date" class="aj-campo-filtro__controle" @bind="_filtro.Ate" /></label>
            <div class="aj-so-tablet"><button type="button" class="aj-botao aj-botao--secundario aj-botao--com-icone" aria-expanded="@(_filtrosAbertos ? "true" : "false")" aria-controls="filtros-da-auditoria" @onclick="AlternarFiltros"><Icone Nome="filtros" />@RotuloDosFiltros</button></div>
            <div class="aj-so-mobile"><button type="button" class="aj-botao aj-botao--secundario aj-botao--icone" aria-label="Mais filtros" aria-expanded="@(_filtrosAbertos ? "true" : "false")" aria-controls="filtros-da-auditoria" @onclick="AlternarFiltros"><Icone Nome="filtros" /></button></div>
            @* Sem botão de envio, o Enter nos campos de data não envia este formulário: este, escondido, o aciona.
               A classe é aj-so-leitor porque aj-botao define display e anularia o hidden. *@
            <button type="submit" class="aj-so-leitor" hidden>Filtrar</button>
        </form>

        @* Fechado, o painel fica no HTML, escondido, para o aria-controls dos dois botões apontar para ele. *@
        <PainelDeFiltros Id="filtros-da-auditoria" Aberto="_filtrosAbertos" AoFiltrar="FiltrarDoPainelAsync" AoLimpar="LimparFiltros" AoFechar="FecharFiltros">
            <label class="aj-campo-filtro"><span>Usuário</span><select class="aj-campo-filtro__controle" @bind="_filtro.UsuarioId"><option value="">Todos</option>@foreach (var usuario in _usuarios) { <option value="@usuario.Id">@usuario.Nome</option> }</select></label>
            @if (_aba == Aba.Alteracoes)
            {
                <label class="aj-campo-filtro"><span>Operação</span><select class="aj-campo-filtro__controle" @bind="_filtro.Operacao"><option value="">Todas</option><option value="@OperacaoAuditada.Criacao">Criação</option><option value="@OperacaoAuditada.Alteracao">Alteração</option><option value="@OperacaoAuditada.Exclusao">Exclusão</option><option value="@OperacaoAuditada.Evento">Evento</option></select></label>
                <label class="aj-campo-filtro"><span>Entidade</span><input type="text" class="aj-campo-filtro__controle" placeholder="Usuario, Perfil…" @bind="_filtro.Entidade" /></label>
                <label class="aj-campo-filtro"><span>Registro</span><input type="text" class="aj-campo-filtro__controle" placeholder="Identificador do registro" @bind="_filtro.EntidadeId" /></label>
                <label class="aj-campo-filtro"><span>Gravação</span><input type="text" class="aj-campo-filtro__controle" placeholder="Identificador de correlação" @bind="_filtro.IdCorrelacao" /></label>
            }
            else
            {
                <label class="aj-campo-filtro"><span>Ação</span><select class="aj-campo-filtro__controle" @bind="_filtro.Acao"><option value="">Todas</option><option value="@AcaoDeAcesso.Listou">Listou</option><option value="@AcaoDeAcesso.Visualizou">Visualizou</option><option value="@AcaoDeAcesso.Baixou">Baixou</option></select></label>
                <label class="aj-campo-filtro"><span>Recurso</span><input type="text" class="aj-campo-filtro__controle" placeholder="Usuario, RegistroAuditoria…" @bind="_filtro.TipoRecurso" /></label>
            }
        </PainelDeFiltros>
    </div>

    @if (_identificadorInvalido)
    {
        <Aviso Tipo="TipoDeAviso.Erro">Identificador inválido.</Aviso>
    }
    else
    {
        <EstadoDaLista Erro="@_erro" Carregando="@(!_consultou)" Vazio="@(Total == 0)" TextoDeVazio="Nenhum registro." TentarDeNovo="TentarDeNovoAsync">
            @if (_aba == Aba.Alteracoes)
            {
                <div class="aj-so-desktop">
                    <div class="aj-tabela-caixa">
                        <table class="aj-tabela">
                            <thead><tr><th scope="col">Quando</th><th scope="col">Quem</th><th scope="col">Operação</th><th scope="col">Sobre</th><th scope="col">Dados</th><th scope="col">IP</th><th scope="col">Correlação</th></tr></thead>
                            <tbody>
                                @foreach (var registro in _alteracoes.Itens)
                                {
                                    <tr @key="registro.Id">
                                        <td class="aj-tabela__data">@Fuso.Formatar(registro.DataHora)</td>
                                        <td>@Quem(registro)</td>
                                        <td class="aj-tabela__principal">@Operacao(registro)</td>
                                        <td class="aj-tabela__sem-quebra">@registro.Entidade @if (registro.EntidadeId is { } entidadeId)
                                        {
                                            <button type="button" class="aj-botao aj-botao--fantasma aj-identificador" title="Ver tudo deste registro" disabled="@_ocupado" @onclick="() => FiltrarPorRegistroAsync(entidadeId)">@IdentificadorCurto.De(entidadeId)</button>
                                        }</td>
                                        <td><code class="aj-dados">@ResumoDeAuditoria.De(registro.Dados, Fuso)</code></td>
                                        <td class="aj-tabela__data">@Ou(registro.Ip)</td>
                                        <td>@if (registro.IdCorrelacao is { } correlacao)
                                        {
                                            <button type="button" class="aj-botao aj-botao--fantasma aj-identificador" title="Ver o que foi gravado junto" disabled="@_ocupado" @onclick="() => FiltrarPorCorrelacaoAsync(correlacao)">@IdentificadorCurto.De(correlacao)</button>
                                        }</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="aj-tablet-mobile">
                    <div class="aj-grade">
                        @foreach (var registro in _alteracoes.Itens)
                        {
                            <div class="aj-painel aj-painel--registro" @key="registro.Id">
                                <span class="aj-registro__titulo">@($"{Operacao(registro)} · {registro.Entidade}")</span>
                                <span class="aj-ajuda">@Meta(Quem(registro), registro.DataHora, registro.Ip)</span>
                                @if (!string.IsNullOrWhiteSpace(registro.Dados))
                                {
                                    <code class="aj-dados">@ResumoDeAuditoria.De(registro.Dados, Fuso)</code>
                                }
                                @if (registro.EntidadeId is not null || registro.IdCorrelacao is not null)
                                {
                                    <span class="aj-registro__ids">
                                        @if (registro.EntidadeId is { } entidadeId)
                                        {
                                            <button type="button" class="aj-botao aj-botao--fantasma aj-identificador" title="Ver tudo deste registro" disabled="@_ocupado" @onclick="() => FiltrarPorRegistroAsync(entidadeId)">@($"Registro {IdentificadorCurto.De(entidadeId)}")</button>
                                        }
                                        @if (registro.IdCorrelacao is { } correlacao)
                                        {
                                            <button type="button" class="aj-botao aj-botao--fantasma aj-identificador" title="Ver o que foi gravado junto" disabled="@_ocupado" @onclick="() => FiltrarPorCorrelacaoAsync(correlacao)">@($"Gravação {IdentificadorCurto.De(correlacao)}")</button>
                                        }
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="aj-so-desktop">
                    <div class="aj-tabela-caixa">
                        <table class="aj-tabela">
                            <thead><tr><th scope="col">Quando</th><th scope="col">Quem</th><th scope="col">Ação</th><th scope="col">Recurso</th><th scope="col">Detalhe</th><th scope="col">IP</th></tr></thead>
                            <tbody>
                                @foreach (var registro in _acessos.Itens)
                                {
                                    <tr @key="registro.Id">
                                        <td class="aj-tabela__data">@Fuso.Formatar(registro.DataHora)</td>
                                        <td>@(registro.UsuarioNome ?? "—")</td>
                                        <td class="aj-tabela__principal">@registro.Acao</td>
                                        <td>@registro.TipoRecurso @if (registro.RecursoId is { } recursoId)
                                        {
                                            <code class="aj-dados">@recursoId</code>
                                        }</td>
                                        <td><code class="aj-dados">@Ou(registro.Detalhe)</code></td>
                                        <td class="aj-tabela__data">@Ou(registro.Ip)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="aj-tablet-mobile">
                    <div class="aj-grade">
                        @foreach (var registro in _acessos.Itens)
                        {
                            <div class="aj-painel aj-painel--registro" @key="registro.Id">
                                <span class="aj-registro__titulo">@($"{registro.Acao} · {registro.TipoRecurso}")</span>
                                <span class="aj-ajuda">@Meta(registro.UsuarioNome ?? "—", registro.DataHora, registro.Ip)</span>
                                @if (!string.IsNullOrWhiteSpace(registro.Detalhe))
                                {
                                    <code class="aj-dados">@registro.Detalhe</code>
                                }
                                @if (registro.RecursoId is { } recursoId)
                                {
                                    <code class="aj-dados">@recursoId</code>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </EstadoDaLista>
    }

    @* A paginação é da consulta respondida: enquanto a aba nova carrega, depois de uma falha ou com um identificador
       inválido (que não consulta), ela sai, para não mostrar os números de outra consulta. *@
    @if (_consultou && !_identificadorInvalido)
    {
        <Paginacao Numero="_pagina" TotalDePaginas="TotalDePaginas" Total="Total" Singular="registro" Plural="registros"
                   SempreVisivel="true" Ocupado="_ocupado" IrPara="IrParaAsync" />
    }
}

@code {
    private enum Aba { Alteracoes, Acessos }

    private static readonly Pagina<RegistroAuditoriaResumo> SemAlteracoes = new([], 0, 1, ConsultaDeAuditoriaOpcoes.TamanhoDaPagina);
    private static readonly Pagina<RegistroAcessoResumo> SemAcessos = new([], 0, 1, ConsultaDeAuditoriaOpcoes.TamanhoDaPagina);

    private bool _carregado;
    private bool _autorizado;
    private bool _ocupado;
    private bool _consultou;
    private bool _usuariosCarregados;
    private bool _filtrosAbertos;
    private bool _identificadorInvalido;
    private string? _erro;
    private Aba _aba = Aba.Alteracoes;
    private int _pagina = 1;
    // O filtro em edição (os campos das três visões) e o aplicado, do último "Filtrar" ou do botão de uma linha: o que a
    // lista está mostrando. A consulta só lê o aplicado.
    private FiltroDaTelaDeAuditoria _filtro = new();
    private FiltroDaTelaDeAuditoria _aplicado = new();
    private IReadOnlyList<UsuarioResumo> _usuarios = [];
    private Pagina<RegistroAuditoriaResumo> _alteracoes = SemAlteracoes;
    private Pagina<RegistroAcessoResumo> _acessos = SemAcessos;

    private int Total => _aba == Aba.Alteracoes ? _alteracoes.Total : _acessos.Total;
    private int TotalDePaginas => _aba == Aba.Alteracoes ? _alteracoes.TotalDePaginas : _acessos.TotalDePaginas;

    // Sem consulta respondida (carregando, falha, identificador inválido) ou sem nenhum registro não há total a mostrar.
    private string? Subtitulo => _carregado && _autorizado && !_identificadorInvalido && _erro is null && _consultou && Total > 0
        ? $"{Contagem.De(Total, "registro", "registros")} no período"
        : null;

    private string RotuloDosFiltros => _aba == Aba.Alteracoes ? "Usuário, operação" : "Usuário, ação";

    private string Pressionado(Aba aba) => _aba == aba ? "true" : "false";

    private static string Quem(RegistroAuditoriaResumo registro) =>
        registro.UsuarioNome ?? (registro.UsuarioId is null ? "Sistema" : "—");

    private static string Operacao(RegistroAuditoriaResumo registro) => registro.Evento ?? Rotulo(registro.Operacao);

    private string Meta(string quem, DateTime quando, string? ip) =>
        $"{(quem == "—" ? "Usuário não identificado" : quem)} · {Fuso.Formatar(quando)}{(string.IsNullOrWhiteSpace(ip) ? "" : $" · IP {ip}")}";

    private static string Ou(string? valor) => string.IsNullOrWhiteSpace(valor) ? "—" : valor;

    // O mesmo controle vai ao cabeçalho (desktop e tablet) e à barra superior do mobile.
    private RenderFragment Segmentado => @<div class="aj-segmentado aj-segmentado--recuado" role="group" aria-label="O que consultar">
        <button type="button" class="aj-segmentado__opcao" aria-pressed="@Pressionado(Aba.Alteracoes)" @onclick="() => TrocarAbaAsync(Aba.Alteracoes)">Alterações e eventos</button>
        <button type="button" class="aj-segmentado__opcao" aria-pressed="@Pressionado(Aba.Acessos)" @onclick="() => TrocarAbaAsync(Aba.Acessos)">Consultas</button>
    </div>;

    protected override async Task OnInitializedAsync()
    {
        _autorizado = await Despachante.EnviarAsync(new ObterMeuAcesso()) is { EhDiretoria: true };
        if (_autorizado) await CarregarInicioAsync();
        _carregado = true;
    }

    // A carga inicial: os usuários do filtro e a primeira página. Se os usuários falham, o erro fica no lugar da lista e
    // o "Tentar de novo" volta aqui, até eles chegarem. Uma vez por clique.
    private async Task CarregarInicioAsync()
    {
        if (_ocupado) return;

        Resultado<IReadOnlyList<UsuarioResumo>> usuarios;
        _ocupado = true;
        try
        {
            usuarios = await Despachante.EnviarAsync(new ListarUsuarios());
        }
        finally
        {
            _ocupado = false;
        }

        _usuarios = usuarios.Valor ?? [];
        if (!usuarios.Sucesso)
        {
            Concluir(usuarios);
            return;
        }

        _usuariosCarregados = true;
        await IrParaAsync(1);
    }

    private Task TrocarAbaAsync(Aba aba)
    {
        if (_ocupado) return Task.CompletedTask;
        _aba = aba;
        // A aba nova ainda não respondeu: sem contagem nem "Nenhum registro." até a consulta voltar.
        _consultou = false;
        return IrParaAsync(1);
    }

    // "Filtrar" (a barra do desktop, a linha do tablet e do mobile, o painel) é o único lugar que grava o filtro
    // aplicado: tudo o que está nos campos. Com outra consulta em curso, nada muda.
    private Task<Carga> AplicarAsync()
    {
        if (_ocupado) return Task.FromResult(Carga.EmAndamento);

        _aplicado = _filtro.Copia();
        return ConsultarPaginaAsync(1);
    }

    private Task FiltrarAsync() => AplicarAsync();

    // Se a carga inicial falhou nos usuários, ela é refeita; senão, a página pedida de novo, com o filtro aplicado.
    private Task TentarDeNovoAsync() => _usuariosCarregados ? IrParaAsync(_pagina) : CarregarInicioAsync();

    // Abrir ou fechar o painel pelo botão descarta o que se escolheu nele e não se aplicou: os campos do painel voltam ao
    // filtro aplicado. O período, que fica na linha, não muda.
    private void AlternarFiltros()
    {
        _filtrosAbertos = !_filtrosAbertos;
        _filtro.VoltarOsDoPainel(_aplicado);
    }

    // Esc no painel: fecha como o botão.
    private void FecharFiltros()
    {
        _filtrosAbertos = false;
        _filtro.VoltarOsDoPainel(_aplicado);
    }

    // Esvazia os campos que o painel da aba atual traz; o período, que fica na linha, não sai. Só vale ao filtrar.
    private void LimparFiltros()
    {
        _filtro.UsuarioId = null;
        if (_aba == Aba.Alteracoes)
        {
            _filtro.Operacao = null;
            _filtro.Entidade = null;
            _filtro.EntidadeId = null;
            _filtro.IdCorrelacao = null;
        }
        else
        {
            _filtro.Acao = null;
            _filtro.TipoRecurso = null;
        }
    }

    private async Task FiltrarDoPainelAsync()
    {
        // O painel só fecha quando o filtro foi aplicado: um identificador inválido ou uma consulta ignorada o deixam aberto.
        if (await AplicarAsync() == Carga.Feita) _filtrosAbertos = false;
    }

    // Os botões das linhas respondem "tudo sobre isto": aplicam na hora o período aplicado e o registro (os outros
    // filtros saem), e os campos passam a mostrá-lo.
    private Task FiltrarPorRegistroAsync(Guid entidadeId)
    {
        if (_ocupado) return Task.CompletedTask;

        _aplicado = FiltroDaTelaDeAuditoria.PorRegistro(_aplicado, entidadeId);
        _filtro = _aplicado.Copia();
        return IrParaAsync(1);
    }

    private Task FiltrarPorCorrelacaoAsync(Guid idCorrelacao)
    {
        if (_ocupado) return Task.CompletedTask;

        _aplicado = FiltroDaTelaDeAuditoria.PorCorrelacao(_aplicado, idCorrelacao);
        _filtro = _aplicado.Copia();
        return IrParaAsync(1);
    }

    private async Task IrParaAsync(int pagina) => await ConsultarPaginaAsync(pagina);

    private async Task<Carga> ConsultarPaginaAsync(int pagina)
    {
        var anterior = _pagina;
        _pagina = pagina;
        // Com outra consulta em andamento, a página mostrada continua sendo a anterior.
        var carga = await CarregarAsync();
        if (carga == Carga.EmAndamento) _pagina = anterior;
        return carga;
    }

    private enum Carga { Feita, EmAndamento, IdentificadorInvalido }

    private async Task<Carga> CarregarAsync()
    {
        if (_ocupado) return Carga.EmAndamento;
        _erro = null;
        _identificadorInvalido = false;

        // Um identificador que não é um Guid não consulta nada.
        Guid? entidadeId = null, idCorrelacao = null;
        if (_aba == Aba.Alteracoes)
        {
            if (!TentarLerGuid(_aplicado.EntidadeId, out entidadeId) || !TentarLerGuid(_aplicado.IdCorrelacao, out idCorrelacao))
            {
                // Sem consulta não há linhas para mostrar: as da consulta anterior saem e a página volta à primeira, para
                // que o número da página nunca fique sobre linhas de outra consulta.
                _identificadorInvalido = true;
                _alteracoes = SemAlteracoes;
                _pagina = 1;
                return Carga.IdentificadorInvalido;
            }
        }

        _ocupado = true;
        try
        {
            await ConsultarAsync(entidadeId, idCorrelacao);
            return Carga.Feita;
        }
        finally
        {
            _ocupado = false;
        }
    }

    private static bool TentarLerGuid(string? texto, out Guid? valor)
    {
        valor = null;
        if (string.IsNullOrWhiteSpace(texto)) return true;
        if (!Guid.TryParse(texto.Trim(), out var guid)) return false;
        valor = guid;
        return true;
    }

    private async Task ConsultarAsync(Guid? entidadeId, Guid? idCorrelacao)
    {
        // Os dois limites são dias do escritório: "até" inclui o dia informado inteiro.
        DateTime? de = _aplicado.De is { } d ? Fuso.InicioDoDiaEmUtc(d) : null;
        // Sem limite superior quando o dia não tem sucessor (DateOnly.MaxValue).
        DateTime? ate = _aplicado.Ate is { } a && a != DateOnly.MaxValue ? Fuso.InicioDoDiaEmUtc(a.AddDays(1)) : null;

        if (_aba == Aba.Alteracoes)
        {
            var resultado = await Despachante.EnviarAsync(new ConsultarAuditoria(
                new FiltroDeAuditoria(de, ate, _aplicado.UsuarioId, Limpo(_aplicado.Entidade), _aplicado.Operacao, entidadeId, idCorrelacao), _pagina));
            _alteracoes = resultado.Valor ?? SemAlteracoes;
            Concluir(resultado);
        }
        else
        {
            var resultado = await Despachante.EnviarAsync(new ConsultarAcessos(
                new FiltroDeAcessos(de, ate, _aplicado.UsuarioId, Limpo(_aplicado.TipoRecurso), _aplicado.Acao), _pagina));
            _acessos = resultado.Valor ?? SemAcessos;
            Concluir(resultado);
        }

        _consultou = _erro is null && _autorizado;
    }

    private void Concluir(Resultado resultado)
    {
        // Perder o acesso no meio do uso é diferente de qualquer outra falha.
        if (resultado.Erro == TipoErro.AcessoNegado) _autorizado = false;
        _erro = resultado.Sucesso || resultado.Erro == TipoErro.AcessoNegado ? null : resultado.Mensagem;
    }

    private static string? Limpo(string? texto) => string.IsNullOrWhiteSpace(texto) ? null : texto.Trim();

    private static string Rotulo(OperacaoAuditada operacao) => operacao switch
    {
        OperacaoAuditada.Criacao => "Criação",
        OperacaoAuditada.Alteracao => "Alteração",
        OperacaoAuditada.Exclusao => "Exclusão",
        _ => "Evento",
    };
}
