@page "/"
@inject IDespachante Despachante

<PageTitle>Início</PageTitle>

<h1>Início</h1>

@if (!_carregado)
{
    <p>Carregando…</p>
}
else if (_ator is null)
{
    <p class="erro">Seu acesso foi encerrado. Entre novamente.</p>
}
else
{
    @if (_ator.EhCliente)
    {
        <p>Olá, <strong>@_ator.Nome</strong>.</p>
        <p><a href="/minha-senha">Minha senha</a></p>
    }
    else
    {
        <p>Olá, <strong>@_ator.Nome</strong>. Seu perfil é de @RotulosDePerfil.DoTipo(_ator.TipoPerfil).</p>
        <p><a href="/atividades">Minhas atividades</a></p>
        <p><a href="/agenda">Agenda da semana</a></p>
    }
}

@code {
    private UsuarioAutenticado? _ator;
    private bool _carregado;

    protected override async Task OnInitializedAsync()
    {
        _ator = await Despachante.EnviarAsync(new ObterMeuAcesso());
        _carregado = true;
    }
}
