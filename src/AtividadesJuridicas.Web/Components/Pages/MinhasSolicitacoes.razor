@page "/minhas-solicitacoes"
@inject IDespachante Despachante
@inject FusoDoEscritorio Fuso

<PageTitle>Minhas solicitações</PageTitle>

@* Sem acesso, o cabeçalho fica sem a ação: não há o que pedir com o acesso encerrado. *@
<CabecalhoDePagina Titulo="Minhas solicitações" Subtitulo="@Quantas" Acao="@(_encerrado ? null : "Nova solicitação")"
                   AcaoHref="/minhas-solicitacoes/nova" />

@if (_encerrado)
{
    <Aviso Tipo="TipoDeAviso.Erro">Seu acesso foi encerrado. Entre novamente.</Aviso>
}
else
{
    <div class="aj-chips" role="group" aria-label="Filtrar por situação">
        <button type="button" class="aj-chip" aria-pressed="@Pressionado(null)" @onclick="() => FiltrarAsync(null)">Todas</button>@foreach (var situacao in Situacoes)
        {<button type="button" class="aj-chip" aria-pressed="@Pressionado(situacao)" @key="situacao" @onclick="() => FiltrarAsync(situacao)">@RotulosDeSolicitacao.ParaOCliente(situacao)</button>}
    </div>

    <EstadoDaLista Erro="@_erro" Carregando="@(_pagina is null)" Vazio="@(_pagina is { Itens.Count: 0 })"
                   TextoDeVazio="Nenhuma solicitação." TentarDeNovo="TentarDeNovoAsync">
        @if (_pagina is { } pagina)
        {
            <div class="aj-so-desktop">
                <div class="aj-tabela-caixa">
                    <table class="aj-tabela">
                        <thead><tr><th scope="col">Aberta em</th><th scope="col">Solicitação</th><th scope="col">Urgência</th><th scope="col">Situação</th><th scope="col">Aberta por</th><th scope="col"><span class="aj-so-leitor">Ações</span></th></tr></thead>
                        <tbody>
                            @foreach (var solicitacao in pagina.Itens)
                            {
                                <tr @key="solicitacao.Id">
                                    <td class="aj-tabela__data">@Fuso.Formatar(solicitacao.AbertaEm)</td>
                                    <td class="aj-tabela__principal">@solicitacao.Trecho</td>
                                    <td>@RotulosDeSolicitacao.Urgencia(solicitacao.Urgencia)</td>
                                    <td><span class="@RotulosDeSolicitacao.Etiqueta(solicitacao.Situacao)">@RotulosDeSolicitacao.ParaOCliente(solicitacao.Situacao)</span></td>
                                    <td>@solicitacao.SolicitanteNome</td>
                                    <td class="aj-tabela__acao"><a href="@Ficha(solicitacao.Id)" class="aj-botao aj-botao--fantasma aj-botao--seta">Abrir<Icone Nome="avancar" /></a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <Paginacao Numero="pagina.Numero" TotalDePaginas="pagina.TotalDePaginas" Total="pagina.Total"
                           Singular="solicitação" Plural="solicitações" Ocupado="_carregando" IrPara="IrParaAsync" />
            </div>

            <div class="aj-tablet-mobile">
                <div class="aj-grade">
                    @foreach (var solicitacao in pagina.Itens)
                    {
                        <a href="@Ficha(solicitacao.Id)" class="aj-cartao" @key="solicitacao.Id">
                            <span class="aj-cartao__etiquetas"><span class="@RotulosDeSolicitacao.Etiqueta(solicitacao.Situacao)">@RotulosDeSolicitacao.ParaOCliente(solicitacao.Situacao)</span></span>
                            <span class="aj-cartao__titulo">@solicitacao.Trecho</span>
                            <span class="aj-cartao__meta">@Meta(solicitacao)</span>
                            <span class="aj-cartao__rodape"><span class="aj-cartao__data">@Fuso.Formatar(solicitacao.AbertaEm)</span></span>
                        </a>
                    }
                </div>
                <Paginacao Numero="pagina.Numero" TotalDePaginas="pagina.TotalDePaginas" Total="pagina.Total"
                           Singular="solicitação" Plural="solicitações" Ocupado="_carregando" IrPara="IrParaAsync" />
            </div>
        }
    </EstadoDaLista>
}

@code {
    private static readonly SituacaoParaOCliente[] Situacoes =
    [
        SituacaoParaOCliente.AguardandoAnalise, SituacaoParaOCliente.EmAndamento, SituacaoParaOCliente.Concluida,
        SituacaoParaOCliente.Cancelada,
    ];

    private bool _encerrado;
    private bool _carregando;
    private int _geracao;
    private int _paginaPedida = 1;
    private SituacaoParaOCliente? _situacao;
    private string? _erro;
    private Pagina<SolicitacaoDoPortal>? _pagina;

    protected override Task OnInitializedAsync() => CarregarAsync(1);

    private string? Quantas => !_encerrado && _pagina is { Total: > 0 } pagina
        ? Contagem.De(pagina.Total, "solicitação", "solicitações")
        : null;

    private static string Ficha(Guid id) => $"/minhas-solicitacoes/{id}";

    private static string Meta(SolicitacaoDoPortal solicitacao) =>
        $"Urgência {RotulosDeSolicitacao.Urgencia(solicitacao.Urgencia)} · {solicitacao.SolicitanteNome}";

    private string Pressionado(SituacaoParaOCliente? situacao) => _situacao == situacao ? "true" : "false";

    private Task FiltrarAsync(SituacaoParaOCliente? situacao)
    {
        _situacao = situacao;
        // Outra situação é outra lista: a anterior sai na hora, e "Carregando…" fica no lugar até a nova chegar.
        _pagina = null;
        return CarregarAsync(1);
    }

    private Task TentarDeNovoAsync() => _carregando ? Task.CompletedTask : CarregarAsync(_paginaPedida);

    private Task IrParaAsync(int pagina) => _carregando ? Task.CompletedTask : CarregarAsync(pagina);

    private async Task CarregarAsync(int pagina)
    {
        // A resposta que chega depois de outra consulta mais nova é descartada: a lista na tela é sempre a da situação
        // escolhida. Na troca de página, a anterior fica à vista, com a paginação esperando, até a nova chegar.
        var geracao = ++_geracao;
        _carregando = true;
        _paginaPedida = pagina;
        _erro = null;
        try
        {
            var resultado = await Despachante.EnviarAsync(new ListarMinhasSolicitacoes(_situacao, pagina));
            if (geracao != _geracao) return;

            if (resultado.Erro == TipoErro.AcessoNegado)
            {
                _pagina = null;
                _encerrado = true;
                return;
            }

            if (!resultado.Sucesso || resultado.Valor is not { } lista)
            {
                // Falha na consulta não é "nenhuma solicitação": o erro fica no lugar da lista.
                _pagina = null;
                _erro = resultado.Mensagem ?? "Não foi possível consultar as solicitações.";
                return;
            }

            // A página ficou além do fim (solicitações mudaram enquanto o cliente paginava): volta à última.
            if (lista.Itens.Count == 0 && lista.Total > 0 && lista.Numero > lista.TotalDePaginas)
            {
                await CarregarAsync(lista.TotalDePaginas);
                return;
            }

            _pagina = lista;
        }
        finally
        {
            if (geracao == _geracao) _carregando = false;
        }
    }
}
