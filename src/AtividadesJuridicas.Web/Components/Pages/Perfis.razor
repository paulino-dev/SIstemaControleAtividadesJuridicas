@page "/perfis"
@using System.ComponentModel.DataAnnotations
@inject IDespachante Despachante

<PageTitle>Perfis</PageTitle>

<CabecalhoDePagina Titulo="Perfis" Subtitulo="@Subtitulo" />

@if (!_carregado)
{
    <p class="aj-subtitulo" role="status">Carregando…</p>
}
else if (!_autorizado)
{
    <Aviso Tipo="TipoDeAviso.Erro">Acesso negado.</Aviso>
}
else
{
    @if (_mensagem is not null)
    {
        <Aviso @key="_versaoDoAviso" Tipo="@(_falhou ? TipoDeAviso.Erro : TipoDeAviso.Sucesso)" Revelar="true">@_mensagem</Aviso>
    }

    <div class="aj-lado-a-lado">
        <div class="aj-so-desktop">
            <div class="aj-lado-a-lado__lista">
                <EstadoDaLista Erro="@_erroDaLista" Vazio="@(_perfis.Count == 0)" TextoDeVazio="Nenhum perfil." TentarDeNovo="TentarDeNovoAsync">
                    <div class="aj-tabela-caixa">
                        <table class="aj-tabela">
                            <thead><tr><th scope="col">Nome</th><th scope="col">Tipo</th><th scope="col">Usuários ativos</th><th scope="col">Situação</th><th scope="col"><span class="aj-so-leitor">Ações</span></th></tr></thead>
                            <tbody>
                                @foreach (var perfil in _perfis)
                                {
                                    <tr class="@ClasseDaLinha(perfil)" @key="perfil.Id">
                                        <td class="aj-tabela__principal">@perfil.Nome</td>
                                        <td>@RotulosDePerfil.DoTipo(perfil.Tipo)</td>
                                        <td>@perfil.UsuariosAtivos</td>
                                        <td>@Situacao(perfil)</td>
                                        @* Os dois botões colados: o espaço entre eles seria desenhado. *@
                                        <td class="aj-tabela__acao aj-tabela__acao--varias"><button type="button" class="aj-botao aj-botao--fantasma aj-botao--menor" @onclick="() => Editar(perfil)">Renomear</button><button type="button" class="aj-botao aj-botao--fantasma aj-botao--menor" disabled="@_salvando" @onclick="() => AlternarAtivoAsync(perfil)">@Alternar(perfil)</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </EstadoDaLista>
            </div>
        </div>

        <div class="aj-tablet-mobile">
            <EstadoDaLista Erro="@_erroDaLista" Vazio="@(_perfis.Count == 0)" TextoDeVazio="Nenhum perfil." TentarDeNovo="TentarDeNovoAsync">
                <section class="aj-painel aj-painel--principal aj-painel--lista">
                    <h2>Perfis</h2>
                    @foreach (var perfil in _perfis)
                    {
                        <div class="@ClasseDaLinhaNoPainel(perfil)" @key="perfil.Id">
                            <div class="aj-linha__texto"><span class="aj-linha__titulo">@perfil.Nome</span><span class="aj-ajuda">@Resumo(perfil)</span></div>
                            <MenuDeAcoes Rotulo="@($"Ações de {perfil.Nome}")">
                                <button type="button" class="aj-menu-acoes__item" @onclick="() => Editar(perfil)">Renomear</button>
                                <button type="button" class="aj-menu-acoes__item" disabled="@_salvando" @onclick="() => AlternarAtivoAsync(perfil)">@Alternar(perfil)</button>
                            </MenuDeAcoes>
                        </div>
                    }
                </section>
            </EstadoDaLista>
        </div>

        <EditForm Model="_form" OnValidSubmit="SalvarAsync" FormName="perfil" class="aj-painel aj-lado-a-lado__painel">
            <DataAnnotationsValidator />
            <h2>@TituloDoPainel</h2>
            <RotuloDeCampo Texto="Nome" Para="() => _form.Nome">
                <InputText @ref="_campoNome" @bind-Value="_form.Nome" class="aj-campo" />
            </RotuloDeCampo>
            <label class="aj-rotulo">
                Tipo
                <InputSelect @bind-Value="_form.Tipo" disabled="@(_form.Id is not null)" class="aj-campo">
                    <option value="@TipoPerfil.Producao">Produção</option>
                    <option value="@TipoPerfil.Diretoria">Diretoria</option>
                    @if (_form.Tipo == TipoPerfil.Cliente)
                    {
                        @* Só ao renomear o perfil de cliente, para o campo (desabilitado) mostrar o tipo dele. *@
                        <option value="@TipoPerfil.Cliente">Cliente</option>
                    }
                </InputSelect>
            </label>
            @if (_form.Id is null)
            {
                <span class="aj-ajuda">O tipo não pode ser mudado depois. Um perfil novo passa a acessar todos os Documentos Gerais já existentes; um perfil de Diretoria acessa tudo, inclusive os Contratos de Honorários.</span>
            }
            <div class="aj-painel__acoes"><button type="button" class="aj-botao aj-botao--fantasma" @onclick="Limpar">Cancelar</button><button type="submit" class="aj-botao aj-botao--primario" disabled="@_salvando">Salvar</button></div>
        </EditForm>
    </div>
}

@code {
    private bool _carregado;
    private bool _autorizado;
    private bool _falhou;
    private bool _salvando;
    private bool _focarNome;
    private bool _listaCarregada;
    private string? _mensagem;
    private string? _erroDaLista;
    private InputText? _campoNome;
    private IReadOnlyList<PerfilDetalhe> _perfis = [];
    private Formulario _form = new();

    // A geração do aviso de resultado: cada mensagem nova de uma ação recria o Aviso (a chave muda), que se revela de
    // novo e recebe o foco (o item do menu que a pediu fica escondido com o menu fechado).
    private int _versaoDoAviso;

    private string? Subtitulo => _carregado && _autorizado && _erroDaLista is null && _perfis.Count > 0
        ? Contagem.ComInativos(_perfis.Count, _perfis.Count(p => !p.Ativo), "perfil", "perfis", "inativo", "inativos")
        : null;

    private string TituloDoPainel => _form.Id is null ? "Novo perfil" : "Renomear perfil";

    private static string Situacao(PerfilDetalhe perfil) => perfil.Ativo ? "Ativo" : "Inativo";

    private static string Resumo(PerfilDetalhe perfil) =>
        $"{RotulosDePerfil.DoTipo(perfil.Tipo)} · {Contagem.De(perfil.UsuariosAtivos, "usuário ativo", "usuários ativos")} · {Situacao(perfil)}";

    private static string Alternar(PerfilDetalhe perfil) => perfil.Ativo ? "Inativar" : "Ativar";

    private static string? ClasseDaLinha(PerfilDetalhe perfil) => perfil.Ativo ? null : "aj-tabela__linha--inativa";

    private static string ClasseDaLinhaNoPainel(PerfilDetalhe perfil) => perfil.Ativo ? "aj-linha" : "aj-linha aj-linha--inativa";

    protected override async Task OnInitializedAsync()
    {
        _autorizado = await Despachante.EnviarAsync(new ObterMeuAcesso()) is { EhDiretoria: true };
        if (_autorizado) await RecarregarAsync();
        _carregado = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focarNome) return;

        _focarNome = false;
        try
        {
            if (_campoNome?.Element is { } campo) await campo.FocusAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSException or JSDisconnectedException)
        {
            // Sem foco (circuito caindo, por exemplo) o painel continua preenchido e funcional.
        }
    }

    // Falso quando a recarga falhou; o motivo já ficou na tela (no lugar da lista, se ainda não havia lista).
    private async Task<bool> RecarregarAsync()
    {
        var resultado = await Despachante.EnviarAsync(new ListarPerfis());
        if (resultado.Erro == TipoErro.AcessoNegado)
        {
            _autorizado = false;
            return false;
        }

        // Falha na recarga não apaga a lista que já está na tela.
        if (resultado.Sucesso && resultado.Valor is { } lista)
        {
            _perfis = lista;
            _listaCarregada = true;
            _erroDaLista = null;
            return true;
        }

        // Só a falha da primeira consulta (nada na tela ainda) toma o lugar da lista.
        if (!_listaCarregada)
        {
            _erroDaLista = resultado.Mensagem;
            return false;
        }

        _falhou = true;
        _mensagem = resultado.Mensagem;
        _versaoDoAviso++;
        return false;
    }

    private Task TentarDeNovoAsync() => RecarregarAsync();

    private void Limpar()
    {
        _form = new Formulario();
        _mensagem = null;
    }

    private void Editar(PerfilDetalhe perfil)
    {
        _mensagem = null;
        _form = new Formulario { Id = perfil.Id, Nome = perfil.Nome, Tipo = perfil.Tipo };
        _focarNome = true;
    }

    private async Task SalvarAsync()
    {
        // Um segundo clique enquanto o primeiro não terminou recriaria o perfil e acusaria nome repetido.
        if (_salvando) return;

        _salvando = true;
        try
        {
            var resultado = await Despachante.EnviarAsync(new SalvarPerfil(_form.Id, _form.Nome, _form.Tipo));
            if (await ConcluirAsync(resultado, "Perfil salvo.")) _form = new Formulario();
        }
        finally
        {
            _salvando = false;
        }
    }

    private async Task AlternarAtivoAsync(PerfilDetalhe perfil)
    {
        if (_salvando) return;

        _salvando = true;
        try
        {
            var resultado = await Despachante.EnviarAsync(new DefinirAtivoPerfil(perfil.Id, !perfil.Ativo));
            await ConcluirAsync(resultado, perfil.Ativo ? "Perfil inativado." : "Perfil ativado.");
        }
        finally
        {
            _salvando = false;
        }
    }

    // Verdadeiro quando a ação deu certo.
    private async Task<bool> ConcluirAsync(Resultado resultado, string mensagemDeSucesso)
    {
        // Perdeu o acesso no meio do uso: some a tela de gestão, o servidor já recusou a gravação.
        if (resultado.Erro == TipoErro.AcessoNegado)
        {
            _autorizado = false;
            return false;
        }

        if (!resultado.Sucesso)
        {
            _falhou = true;
            _mensagem = resultado.Mensagem;
            _versaoDoAviso++;
            return false;
        }

        // A ação deu certo; se só a recarga falhou, o aviso diz isso e a lista anterior fica na tela.
        if (await RecarregarAsync())
        {
            _falhou = false;
            _mensagem = mensagemDeSucesso;
            _versaoDoAviso++;
        }
        else if (_autorizado)
        {
            _falhou = true;
            _mensagem = $"{mensagemDeSucesso.TrimEnd('.')}, mas não foi possível atualizar a lista.";
            _versaoDoAviso++;
        }
        return true;
    }

    private sealed class Formulario
    {
        public Guid? Id { get; set; }

        [Required(ErrorMessage = "Informe o nome.")]
        public string Nome { get; set; } = string.Empty;

        public TipoPerfil Tipo { get; set; } = TipoPerfil.Producao;
    }
}
