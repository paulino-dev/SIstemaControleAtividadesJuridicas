@page "/produtores"
@inject IDespachante Despachante
@inject NavigationManager Navegacao

<PageTitle>Produtores</PageTitle>

<CabecalhoDePagina Titulo="Produtores" Subtitulo="@Subtitulo" />

@if (!_carregado)
{
    <p class="aj-subtitulo" role="status">Carregando…</p>
}
else if (!_autorizado)
{
    <Aviso Tipo="TipoDeAviso.Erro">Acesso negado.</Aviso>
}
else if (_produtores.Count == 0)
{
    <EstadoDaLista Vazio="true" TextoDeVazio="Nenhum produtor." />
}
else
{
    <div class="@(_escolhido is null ? "aj-lado-a-lado" : "aj-lado-a-lado aj-lado-a-lado--painel-largo")">
        <div class="aj-so-desktop">
            <div class="aj-lado-a-lado__lista">
                <div class="aj-tabela-caixa">
                    <table class="aj-tabela">
                        <thead><tr><th scope="col">Nome</th><th scope="col">Perfil</th><th scope="col">OAB</th><th scope="col">Situação</th><th scope="col"><span class="aj-so-leitor">Ações</span></th></tr></thead>
                        <tbody>
                            @foreach (var produtor in _produtores)
                            {
                                <tr class="@ClasseDaLinha(produtor)" @key="produtor.Id">
                                    <td class="aj-tabela__principal">@produtor.Nome</td>
                                    <td>@produtor.PerfilNome</td>
                                    <td class="aj-tabela__data">@Ou(produtor.NumeroOab)</td>
                                    <td>@(produtor.Ativo ? "Ativo" : "Inativo")</td>
                                    <td class="aj-tabela__acao">
                                        @if (produtor.Id == _escolhido?.Id)
                                        {
                                            <span class="aj-tabela__marca">Em acompanhamento</span>
                                        }
                                        else
                                        {
                                            <a href="@Endereco(produtor)" class="aj-botao aj-botao--fantasma aj-botao--seta">Acompanhar<Icone Nome="avancar" /></a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (_escolhido is { } escolhido)
        {
            @* O painel é do produtor do endereço: trocar de produtor troca o painel (a chave), e o mês volta ao corrente. *@
            <PainelDeProdutividade @key="escolhido.Id" ProdutorId="escolhido.Id" ProdutorNome="@escolhido.Nome"
                                   OnAcessoEncerrado="EncerrarAcesso" SeletorDoProdutor="SeletorDoProdutor" />
        }
        else
        {
            <div class="aj-tablet-mobile">
                <div class="aj-linha-filtros aj-linha-filtros--empilha">@SeletorDoProdutor</div>
            </div>
        }
    </div>
}

@code {
    /// <summary>O produtor escolhido, no endereço (<c>?produtor=</c>). Texto que não é um id de produtor da lista não abre nada.</summary>
    [SupplyParameterFromQuery(Name = "produtor")] public string? ProdutorNoEndereco { get; set; }

    private bool _carregado;
    private bool _autorizado;
    private IReadOnlyList<UsuarioResumo> _produtores = [];
    private UsuarioResumo? _escolhido;

    private string? Subtitulo => _carregado && _autorizado && _produtores.Count > 0
        ? Contagem.De(_produtores.Count, "produtor", "produtores")
        : null;

    /// <summary>O campo "Produtor" do tablet e do mobile: na linha de filtros da página, ou dentro do painel quando há escolha.</summary>
    private RenderFragment SeletorDoProdutor => @<label class="aj-campo-filtro aj-campo-filtro--largo">
        <span>Produtor</span>
        <select class="aj-campo-filtro__controle" value="@(_escolhido?.Id.ToString() ?? string.Empty)" @onchange="Escolher">
            @if (_escolhido is null)
            {
                <option value="">Escolha o produtor</option>
            }
            @foreach (var produtor in _produtores)
            {
                <option value="@produtor.Id">@NomeNoSeletor(produtor)</option>
            }
        </select>
    </label>;

    protected override async Task OnInitializedAsync()
    {
        // Quem não é da Diretoria nem chega a pedir a lista de usuários: abrir a página não vira acesso negado na auditoria.
        _autorizado = await Despachante.EnviarAsync(new ObterMeuAcesso()) is { EhDiretoria: true };
        if (_autorizado)
        {
            var resultado = await Despachante.EnviarAsync(new ListarUsuarios());
            _autorizado = resultado.Sucesso;

            // Produtor é quem tem hoje um perfil de Produção. Os inativos ficam, para a consulta de meses passados.
            _produtores = [.. (resultado.Valor ?? [])
                .Where(u => u.TipoPerfil == TipoPerfil.Producao)
                .OrderBy(u => u.Nome, StringComparer.CurrentCultureIgnoreCase)];
        }

        _carregado = true;
    }

    protected override void OnParametersSet()
    {
        // Só vale quem está na lista de produtores: o resto do endereço não abre painel nem consulta.
        _escolhido = Guid.TryParse(ProdutorNoEndereco, out var id)
            ? _produtores.FirstOrDefault(p => p.Id == id)
            : null;
    }

    private void Escolher(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value as string, out var id) && _produtores.FirstOrDefault(p => p.Id == id) is { } produtor)
        {
            Navegacao.NavigateTo(Endereco(produtor));
        }
    }

    private static string Endereco(UsuarioResumo produtor) => $"/produtores?produtor={produtor.Id}";

    private string? ClasseDaLinha(UsuarioResumo produtor)
    {
        var classes = new List<string>();
        if (!produtor.Ativo) classes.Add("aj-tabela__linha--inativa");
        if (produtor.Id == _escolhido?.Id) classes.Add("aj-tabela__linha--selecionada");
        return classes.Count == 0 ? null : string.Join(' ', classes);
    }

    private static string NomeNoSeletor(UsuarioResumo produtor) => produtor.Ativo ? produtor.Nome : $"{produtor.Nome} (inativo)";

    private static string Ou(string? texto) => string.IsNullOrWhiteSpace(texto) ? "—" : texto;

    /// <summary>Uma resposta de acesso negado encerra a tela: nada do que estava aberto continua visível.</summary>
    private void EncerrarAcesso()
    {
        _autorizado = false;
        _produtores = [];
        _escolhido = null;
    }
}
