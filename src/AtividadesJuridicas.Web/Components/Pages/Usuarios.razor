@page "/usuarios"
@using System.ComponentModel.DataAnnotations
@inject IDespachante Despachante
@inject FusoDoEscritorio Fuso

<PageTitle>Usuários</PageTitle>

<h1>Usuários</h1>

@if (!_carregado)
{
    <p>Carregando…</p>
}
else if (!_autorizado)
{
    <p class="erro">Acesso negado.</p>
}
else
{
    @if (_mensagem is not null)
    {
        <p class="@(_falhou ? "erro" : "ok")" role="status">@_mensagem</p>
    }

    @if (_inativando is { } alvo)
    {
        <div class="confirmacao" role="alertdialog" aria-label="Confirmar inativação" tabindex="-1" @ref="_confirmacao">
            <p><strong>@TextosDaInativacao.Pergunta(alvo.Nome)</strong></p>
            @if (_textoDasPendencias is not null)
            {
                <p>@_textoDasPendencias</p>
            }
            <div class="acoes">
                <button type="button" disabled="@_emAndamento" @onclick="ConfirmarInativacaoAsync">Confirmar inativação</button>
                <button type="button" class="secundario" disabled="@_emAndamento" @onclick="CancelarInativacao">Cancelar</button>
            </div>
        </div>
    }

    <table>
        <thead>
            <tr>
                <th>Nome</th>
                <th>E-mail</th>
                <th>Perfil</th>
                <th>Cliente</th>
                <th>OAB</th>
                <th>Último acesso</th>
                <th>Situação</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var usuario in _usuarios)
            {
                <tr class="@(usuario.Ativo ? null : "inativo")" @key="usuario.Id">
                    <td>@usuario.Nome</td>
                    <td>@usuario.Email</td>
                    <td>@RotuloDoPerfilDe(usuario)</td>
                    <td>@(usuario.ClienteAtivo == false ? $"{usuario.ClienteNome} (inativo — sem acesso ao portal)" : usuario.ClienteNome)</td>
                    <td>@usuario.NumeroOab</td>
                    <td>@Fuso.Formatar(usuario.UltimoAcessoEm)</td>
                    <td>@(usuario.Ativo ? "Ativo" : "Inativo")</td>
                    <td class="acoes">
                        <button type="button" class="secundario" @onclick="() => Editar(usuario)">Editar</button>
                        <button type="button" class="secundario" disabled="@_emAndamento"
                                @onclick="() => AlternarAtivoAsync(usuario)">
                            @(usuario.Ativo ? "Inativar" : "Ativar")
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h2>@(_form.Id is null ? "Novo usuário" : "Editar usuário")</h2>

    <EditForm Model="_form" OnValidSubmit="SalvarAsync" FormName="usuario" class="formulario">
        <DataAnnotationsValidator />

        <label>
            Nome
            <InputText @bind-Value="_form.Nome" />
            <ValidationMessage For="() => _form.Nome" />
        </label>

        <label>
            E-mail
            <InputText @bind-Value="_form.Email" type="email" />
            <ValidationMessage For="() => _form.Email" />
        </label>

        <label>
            Perfil
            <InputSelect Value="_form.PerfilId" ValueExpression="() => _form.PerfilId" ValueChanged="(Guid? id) => AoMudarPerfil(id)">
                @if (_form.PerfilId is null)
                {
                    <option value="">Selecione…</option>
                }
                @if (_perfilInativoAtual is { } inativo)
                {
                    <option value="@inativo.Id">@Rotulo(inativo)</option>
                }
                @foreach (var perfil in _perfis.Where(p => p.Ativo && PodeEscolher(p)))
                {
                    <option value="@perfil.Id">@Rotulo(perfil)</option>
                }
            </InputSelect>
            <ValidationMessage For="() => _form.PerfilId" />
            @if (_perfilInativoAtual is { } atual && _form.PerfilId == atual.Id)
            {
                <small>O perfil atual está inativo. Escolha um perfil ativo para poder reativar o usuário.</small>
            }
        </label>

        @if (PerfilEscolhidoEhDeCliente)
        {
            <div class="formulario">
                <strong>Cliente</strong>
                @if (_form.ClienteId is not null)
                {
                    <div class="acoes">
                        <span>Cliente: <strong>@_form.ClienteNome</strong></span>
                        <button type="button" class="secundario" @onclick="TrocarCliente">Trocar</button>
                    </div>
                }
                else
                {
                    @* O Enter na busca submete o formulário "busca-de-cliente" (declarado depois do EditForm), não o do usuário. *@
                    <div class="filtros formulario">
                        <label>
                            Buscar cliente (nome, CPF ou CNPJ)
                            <input type="text" form="busca-de-cliente" @bind="_buscaDeCliente" @bind:event="oninput" />
                        </label>
                        <button type="submit" form="busca-de-cliente" class="secundario">Buscar</button>
                    </div>
                    @foreach (var candidato in _clientesEncontrados)
                    {
                        <div class="acoes" @key="candidato.Id">
                            <span>@candidato.Nome — @candidato.Documento</span>
                            <button type="button" class="secundario" @onclick="() => EscolherCliente(candidato)">Escolher</button>
                        </div>
                    }
                    @if (_nenhumCliente)
                    {
                        <p>Nenhum cliente encontrado.</p>
                    }
                    @if (_clientesTruncados)
                    {
                        <p>Mostrando os primeiros resultados. Refine a busca para ver outros.</p>
                    }
                }
                @if (_erroDoCliente is not null)
                {
                    <p class="erro" role="status">@_erroDoCliente</p>
                }
            </div>
        }
        else
        {
            <label>
                Número da OAB (opcional)
                <InputText @bind-Value="_form.NumeroOab" />
            </label>
        }

        <label>
            @(_form.Id is null ? "Senha" : "Nova senha (deixe em branco para manter)")
            <InputText @bind-Value="_form.Senha" type="password" autocomplete="new-password" />
        </label>

        <div class="acoes">
            <button type="submit">Salvar</button>
            <button type="button" class="secundario" @onclick="Limpar">Cancelar</button>
        </div>
    </EditForm>

    <form id="busca-de-cliente" @onsubmit="BuscarClientesAsync" @onsubmit:preventDefault></form>
}

@code {
    private bool _carregado;
    private bool _autorizado;
    private bool _falhou;
    private string? _mensagem;
    private bool _emAndamento;
    private UsuarioResumo? _inativando;
    private string? _textoDasPendencias;
    private ElementReference _confirmacao;
    private bool _focarConfirmacao;
    private IReadOnlyList<UsuarioResumo> _usuarios = [];
    private IReadOnlyList<PerfilDetalhe> _perfis = [];
    private PerfilDetalhe? _perfilInativoAtual;
    private Formulario _form = new();

    // O tipo do perfil do usuário em edição: um usuário de cliente só troca entre perfis de cliente, e a equipe, entre os internos.
    private TipoPerfil? _tipoOriginal;
    private string? _buscaDeCliente;
    private IReadOnlyList<ClienteResumo> _clientesEncontrados = [];
    private bool _nenhumCliente;
    private bool _clientesTruncados;
    private string? _erroDoCliente;

    protected override async Task OnInitializedAsync()
    {
        _autorizado = await Despachante.EnviarAsync(new ObterMeuAcesso()) is { EhDiretoria: true };
        if (_autorizado)
        {
            _perfis = (await Despachante.EnviarAsync(new ListarPerfis())).Valor ?? [];
            await RecarregarAsync();
            Limpar();
        }
        _carregado = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focarConfirmacao) return;

        _focarConfirmacao = false;
        try
        {
            await _confirmacao.FocusAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSException or JSDisconnectedException)
        {
            // Sem foco (circuito caindo, por exemplo) a confirmação continua visível e funcional.
        }
    }

    private async Task RecarregarAsync()
    {
        var resultado = await Despachante.EnviarAsync(new ListarUsuarios());
        _autorizado = resultado.Sucesso;
        _usuarios = resultado.Valor ?? [];
    }

    // Usuário novo começa em um perfil de Produção; sem nenhum, nada é escolhido por ele.
    private void Limpar()
    {
        _perfilInativoAtual = null;
        _tipoOriginal = null;
        LimparBuscaDeCliente();
        _form = new Formulario { PerfilId = _perfis.FirstOrDefault(p => p.Ativo && p.Tipo == TipoPerfil.Producao)?.Id };
    }

    private static string Rotulo(PerfilDetalhe perfil) =>
        $"{perfil.Nome} ({RotulosDePerfil.DoTipo(perfil.Tipo)}{(perfil.Ativo ? "" : " — inativo")})";

    private string RotuloDoPerfilDe(UsuarioResumo usuario)
    {
        var inativo = _perfis.Any(p => p.Id == usuario.PerfilId && !p.Ativo);
        return $"{usuario.PerfilNome} ({RotulosDePerfil.DoTipo(usuario.TipoPerfil)}{(inativo ? " — inativo" : "")})";
    }

    private bool PerfilEscolhidoEhDeCliente =>
        _perfis.FirstOrDefault(p => p.Id == _form.PerfilId)?.Tipo == TipoPerfil.Cliente;

    private bool PodeEscolher(PerfilDetalhe perfil) =>
        _tipoOriginal is not { } original || (original == TipoPerfil.Cliente) == (perfil.Tipo == TipoPerfil.Cliente);

    private void AoMudarPerfil(Guid? perfilId)
    {
        _form.PerfilId = perfilId;
        // Fora do perfil de cliente o bloco do cliente some, e o cliente escolhido não vale mais.
        if (!PerfilEscolhidoEhDeCliente) TrocarCliente();
        _erroDoCliente = null;
    }

    private void TrocarCliente()
    {
        _form.ClienteId = null;
        _form.ClienteNome = null;
        LimparBuscaDeCliente();
    }

    private void LimparBuscaDeCliente()
    {
        _buscaDeCliente = null;
        _clientesEncontrados = [];
        _nenhumCliente = false;
        _clientesTruncados = false;
        _erroDoCliente = null;
    }

    private async Task BuscarClientesAsync()
    {
        // Dois Enter seguidos não disparam duas consultas.
        if (_emAndamento) return;
        _emAndamento = true;
        try
        {
            _erroDoCliente = null;
            var resultado = await Despachante.EnviarAsync(new ListarClientes(_buscaDeCliente));
            if (resultado.Erro == TipoErro.AcessoNegado)
            {
                _autorizado = false;
                return;
            }

            var itens = resultado.Valor?.Itens ?? [];
            _clientesEncontrados = itens;
            // Os avisos valem só para uma busca que deu certo; uma falha mostra o erro no lugar deles.
            _nenhumCliente = resultado.Sucesso && itens.Count == 0;
            _clientesTruncados = resultado.Sucesso && resultado.Valor!.Total > itens.Count;
            if (!resultado.Sucesso) _erroDoCliente = resultado.Mensagem ?? "Não foi possível consultar os clientes.";
        }
        finally
        {
            _emAndamento = false;
        }
    }

    private void EscolherCliente(ClienteResumo cliente)
    {
        _form.ClienteId = cliente.Id;
        _form.ClienteNome = cliente.Nome;
        LimparBuscaDeCliente();
    }

    private void Editar(UsuarioResumo usuario)
    {
        _mensagem = null;
        _inativando = null;   // uma confirmação pendente não sobrevive a outra ação da linha
        _perfilInativoAtual = _perfis.FirstOrDefault(p => p.Id == usuario.PerfilId && !p.Ativo);
        _tipoOriginal = usuario.TipoPerfil;
        LimparBuscaDeCliente();
        _form = new Formulario
        {
            Id = usuario.Id,
            Nome = usuario.Nome,
            Email = usuario.Email,
            PerfilId = usuario.PerfilId,
            NumeroOab = usuario.NumeroOab,
            ClienteId = usuario.ClienteId,
            ClienteNome = usuario.ClienteNome,
        };
    }

    private async Task SalvarAsync()
    {
        // Só o usuário de cliente tem cliente (e não tem OAB); para a equipe, o ClienteId vai nulo.
        var ehDeCliente = PerfilEscolhidoEhDeCliente;
        if (ehDeCliente && _form.ClienteId is null)
        {
            _erroDoCliente = "Informe o cliente do usuário.";
            return;
        }

        _erroDoCliente = null;
        var clienteId = ehDeCliente ? _form.ClienteId : null;
        var oab = ehDeCliente ? null : _form.NumeroOab;

        Resultado resultado;
        if (_form.Id is { } id)
        {
            resultado = await Despachante.EnviarAsync(
                new EditarUsuario(id, _form.Nome, _form.Email, _form.PerfilId!.Value, oab, clienteId));
            if (resultado.Sucesso && !string.IsNullOrEmpty(_form.Senha))
                resultado = await Despachante.EnviarAsync(new RedefinirSenhaUsuario(id, _form.Senha));
        }
        else
        {
            resultado = await Despachante.EnviarAsync(
                new CriarUsuario(_form.Nome, _form.Email, _form.Senha ?? string.Empty, _form.PerfilId!.Value, oab, clienteId));
        }

        await ConcluirAsync(resultado, "Usuário salvo.");
        if (resultado.Sucesso) Limpar();
    }

    // Ativar é um clique. Inativar é em dois: o primeiro mostra o que o usuário deixa pendente.
    private async Task AlternarAtivoAsync(UsuarioResumo usuario)
    {
        if (_emAndamento) return;
        _emAndamento = true;
        _mensagem = null;
        _falhou = false;
        _inativando = null;
        try
        {
            if (!usuario.Ativo)
            {
                var ativado = await Despachante.EnviarAsync(new DefinirAtivoUsuario(usuario.Id, true));
                await ConcluirAsync(ativado, "Usuário ativado.");
                return;
            }

            var pendencias = await Despachante.EnviarAsync(new ObterPendenciasDoUsuario(usuario.Id));
            if (pendencias.Erro == TipoErro.AcessoNegado)
            {
                _autorizado = false;
                return;
            }

            // Se a contagem falhar, o motivo aparece e a confirmação continua disponível.
            if (pendencias.Sucesso)
            {
                _textoDasPendencias = TextosDaInativacao.Pendencias(usuario.Nome, pendencias.Valor!);
            }
            else
            {
                _falhou = true;
                _mensagem = pendencias.Mensagem;
                _textoDasPendencias = "Não foi possível verificar as pendências deste usuário.";
            }
            _inativando = usuario;
            _focarConfirmacao = true;
        }
        finally
        {
            _emAndamento = false;
        }
    }

    private async Task ConfirmarInativacaoAsync()
    {
        if (_emAndamento || _inativando is not { } usuario) return;
        _emAndamento = true;
        _mensagem = null;
        _falhou = false;
        try
        {
            var resultado = await Despachante.EnviarAsync(new DefinirAtivoUsuario(usuario.Id, false));
            _inativando = null;
            await ConcluirAsync(resultado, "Usuário inativado.");
        }
        finally
        {
            _emAndamento = false;
        }
    }

    private void CancelarInativacao()
    {
        _inativando = null;
        _mensagem = null;
        _falhou = false;
    }

    private async Task ConcluirAsync(Resultado resultado, string mensagemDeSucesso)
    {
        _falhou = !resultado.Sucesso;
        _mensagem = resultado.Sucesso ? mensagemDeSucesso : resultado.Mensagem;
        await RecarregarAsync();
    }

    private sealed class Formulario
    {
        public Guid? Id { get; set; }

        [Required(ErrorMessage = "Informe o nome.")]
        public string Nome { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe o e-mail.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Selecione o perfil.")]
        public Guid? PerfilId { get; set; }
        public string? NumeroOab { get; set; }
        public Guid? ClienteId { get; set; }
        public string? ClienteNome { get; set; }
        public string? Senha { get; set; }
    }
}
