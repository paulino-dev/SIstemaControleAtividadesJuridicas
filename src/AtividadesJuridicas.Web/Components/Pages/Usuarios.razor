@page "/usuarios"
@inject IDespachante Despachante
@inject FusoDoEscritorio Fuso
@inject Recados Recados
@inject Foco Foco

<PageTitle>Usuários</PageTitle>

<CabecalhoDePagina Titulo="Usuários" Subtitulo="@Subtitulo" Acao="@(_autorizado ? "Novo usuário" : null)" AcaoHref="/usuarios/novo" />

@if (!_carregado)
{
    <p class="aj-subtitulo" role="status">Carregando…</p>
}
else if (!_autorizado)
{
    <Aviso Tipo="TipoDeAviso.Erro">Acesso negado.</Aviso>
}
else
{
    @if (_mensagem is not null)
    {
        <Aviso @key="_versaoDoAviso" Tipo="@(_falhou ? TipoDeAviso.Erro : TipoDeAviso.Sucesso)" Revelar="@(_versaoDoAviso > 0)">@_mensagem</Aviso>
    }

    @if (_inativando is { } alvo)
    {
        <ConfirmacaoDeInativacao @key="alvo.Id" UsuarioId="alvo.Id" Nome="@alvo.Nome" OnConcluido="(Resultado resultado) => AoInativarAsync(alvo, resultado)"
                                 OnCancelar="CancelarInativacao" OnAcessoEncerrado="() => _autorizado = false" />
    }

    <EstadoDaLista Erro="@_erroDaLista" Vazio="@(_usuarios.Count == 0)" TextoDeVazio="Nenhum usuário." TentarDeNovo="TentarDeNovoAsync">
        <div class="aj-so-desktop">
            <div class="aj-tabela-caixa">
                <table class="aj-tabela">
                    <thead><tr><th scope="col">Nome</th><th scope="col">E-mail</th><th scope="col">Perfil</th><th scope="col">Cliente</th><th scope="col">OAB</th><th scope="col">Último acesso</th><th scope="col">Situação</th><th scope="col"><span class="aj-so-leitor">Ações</span></th></tr></thead>
                    <tbody>
                        @foreach (var usuario in _usuarios)
                        {
                            <tr class="@ClasseDaLinha(usuario)" @key="usuario.Id">
                                <td class="aj-tabela__principal">@usuario.Nome</td>
                                <td class="aj-tabela__secundaria">@usuario.Email</td>
                                <td>@RotuloDoPerfilDe(usuario)</td>
                                <td>@(ClienteDe(usuario) ?? "—")</td>
                                <td class="aj-tabela__data">@Ou(usuario.NumeroOab)</td>
                                <td class="aj-tabela__data">@Fuso.Formatar(usuario.UltimoAcessoEm)</td>
                                <td>@Situacao(usuario)</td>
                                @* Os dois botões colados: o espaço entre eles seria desenhado. *@
                                <td class="aj-tabela__acao aj-tabela__acao--varias"><a href="@Edicao(usuario)" class="aj-botao aj-botao--fantasma aj-botao--menor">Editar</a><button type="button" class="aj-botao aj-botao--fantasma aj-botao--menor" id="@($"ativar-ou-inativar-{usuario.Id:N}")" disabled="@_emAndamento" @onclick="() => AlternarAtivoAsync(usuario)">@(usuario.Ativo ? "Inativar" : "Ativar")</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="aj-tablet-mobile">
            <div class="aj-grade">
                @foreach (var usuario in _usuarios)
                {
                    <a href="@Edicao(usuario)" class="@ClasseDoCartao(usuario)" @key="usuario.Id">
                        <span class="aj-cartao__titulo">@usuario.Nome</span>
                        <span class="aj-cartao__meta">@usuario.Email<br />@PerfilDoCartao(usuario)</span>
                        <span class="aj-cartao__rodape"><span class="aj-cartao__nota">@Acesso(usuario)</span><span class="aj-cartao__situacao">@Situacao(usuario)</span></span>
                    </a>
                }
            </div>
        </div>
    </EstadoDaLista>
}

@code {
    private bool _carregado;
    private bool _autorizado;
    private bool _falhou;
    private bool _emAndamento;
    private bool _listaCarregada;
    private string? _mensagem;
    private string? _erroDaLista;
    private UsuarioResumo? _inativando;
    private IReadOnlyList<UsuarioResumo> _usuarios = [];
    private IReadOnlyList<PerfilDetalhe> _perfis = [];

    // A geração do aviso de resultado: cada mensagem nova de uma ação desta tela recria o Aviso (a chave muda), que se
    // revela de novo. O recado de outra tela não muda a geração e não se revela (o foco vai ao título com a navegação).
    private int _versaoDoAviso;

    // O "Inativar" da linha que abriu a confirmação cancelada: o foco volta a ele depois do desenho.
    private string? _focoDeVolta;

    private string? Subtitulo => _carregado && _autorizado && _erroDaLista is null && _usuarios.Count > 0
        ? Contagem.ComInativos(_usuarios.Count, _usuarios.Count(u => !u.Ativo), "usuário", "usuários", "inativo", "inativos")
        : null;

    private static string Edicao(UsuarioResumo usuario) => $"/usuarios/{usuario.Id}/editar";

    private static string Situacao(UsuarioResumo usuario) => usuario.Ativo ? "Ativo" : "Inativo";

    private static string Ou(string? valor) => string.IsNullOrWhiteSpace(valor) ? "—" : valor;

    private static string? ClienteDe(UsuarioResumo usuario) => usuario.ClienteNome is null ? null
        : usuario.ClienteAtivo == false ? $"{usuario.ClienteNome} (inativo — sem acesso ao portal)" : usuario.ClienteNome;

    private string PerfilDoCartao(UsuarioResumo usuario) =>
        ClienteDe(usuario) is { } cliente ? $"{RotuloDoPerfilDe(usuario)} · {cliente}" : RotuloDoPerfilDe(usuario);

    private string Acesso(UsuarioResumo usuario) =>
        usuario.UltimoAcessoEm is null ? "Sem acesso registrado" : $"Último acesso {Fuso.Formatar(usuario.UltimoAcessoEm)}";

    private static string? ClasseDaLinha(UsuarioResumo usuario) => usuario.Ativo ? null : "aj-tabela__linha--inativa";

    private static string ClasseDoCartao(UsuarioResumo usuario) => usuario.Ativo ? "aj-cartao" : "aj-cartao aj-cartao--inativo";

    private string RotuloDoPerfilDe(UsuarioResumo usuario)
    {
        var inativo = _perfis.Any(p => p.Id == usuario.PerfilId && !p.Ativo);
        return $"{usuario.PerfilNome} ({RotulosDePerfil.DoTipo(usuario.TipoPerfil)}{(inativo ? " — inativo" : "")})";
    }

    protected override async Task OnInitializedAsync()
    {
        _autorizado = await Despachante.EnviarAsync(new ObterMeuAcesso()) is { EhDiretoria: true };
        if (_autorizado)
        {
            _perfis = (await Despachante.EnviarAsync(new ListarPerfis())).Valor ?? [];
            await RecarregarAsync();
            if (Recados.Retirar() is { } recado)
            {
                _mensagem = recado.Texto;
                _falhou = recado.Tipo == TipoDeAviso.Erro;
            }
        }
        _carregado = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focoDeVolta is not { } seletor) return;

        _focoDeVolta = null;
        // O Foco engole as falhas do JavaScript: sem foco (circuito caindo, por exemplo) a lista continua funcionando.
        await Foco.FocarPrimeiroVisivelAsync(seletor);
    }

    // Falso quando a recarga falhou. Só a falha da primeira consulta (nada na tela ainda) toma o lugar da lista, com o
    // "Tentar de novo"; depois disso a lista que está na tela fica, e quem chamou avisa.
    private async Task<bool> RecarregarAsync()
    {
        var resultado = await Despachante.EnviarAsync(new ListarUsuarios());
        if (resultado.Erro == TipoErro.AcessoNegado)
        {
            _autorizado = false;
            return false;
        }

        if (resultado.Sucesso && resultado.Valor is { } lista)
        {
            _usuarios = lista;
            _listaCarregada = true;
            _erroDaLista = null;
            return true;
        }

        if (!_listaCarregada) _erroDaLista = resultado.Mensagem;
        return false;
    }

    private Task TentarDeNovoAsync() => RecarregarAsync();

    // Ativar é um clique. Inativar abre a confirmação, que mostra o que o usuário deixa pendente.
    private async Task AlternarAtivoAsync(UsuarioResumo usuario)
    {
        if (_emAndamento) return;
        _emAndamento = true;
        _mensagem = null;
        _falhou = false;
        _inativando = null;
        try
        {
            if (usuario.Ativo)
            {
                _inativando = usuario;
                return;
            }

            var ativado = await Despachante.EnviarAsync(new DefinirAtivoUsuario(usuario.Id, true));
            await ConcluirAsync(ativado, "Usuário ativado.");
        }
        finally
        {
            _emAndamento = false;
        }
    }

    private async Task AoInativarAsync(UsuarioResumo alvo, Resultado resultado)
    {
        // Os botões das linhas seguem ativos durante o envio: se outra confirmação foi aberta nesse intervalo, ela fica,
        // e o resultado deste (sucesso ou falha) não vai ao topo, ao lado dela, como se fosse dela: a confirmação aberta
        // limpou a mensagem anterior, e a lista recarregada mostra a situação dele.
        var outraAberta = _inativando is { } aberta && aberta.Id != alvo.Id;
        if (!outraAberta) _inativando = null;
        await ConcluirAsync(resultado, "Usuário inativado.", calarResultado: outraAberta);
    }

    private void CancelarInativacao()
    {
        if (_inativando is { } alvo) _focoDeVolta = $"#ativar-ou-inativar-{alvo.Id:N}";
        _inativando = null;
        _mensagem = null;
        _falhou = false;
    }

    // calarResultado: a confirmação de outro usuário está aberta no topo; o resultado (e o aviso da recarga que falhou)
    // não vai para lá. A lista recarrega do mesmo jeito, e o acesso encerrado segue como sempre.
    private async Task ConcluirAsync(Resultado resultado, string mensagemDeSucesso, bool calarResultado = false)
    {
        if (resultado.Erro == TipoErro.AcessoNegado)
        {
            _autorizado = false;
            return;
        }

        if (!calarResultado)
        {
            _falhou = !resultado.Sucesso;
            _mensagem = resultado.Sucesso ? mensagemDeSucesso : resultado.Mensagem;
            _versaoDoAviso++;
        }

        // A ação deu certo; se só a recarga falhou, o aviso diz isso e a lista anterior fica na tela.
        if (!await RecarregarAsync() && _autorizado && resultado.Sucesso && !calarResultado)
        {
            _falhou = true;
            _mensagem = $"{mensagemDeSucesso.TrimEnd('.')}, mas não foi possível atualizar a lista.";
            _versaoDoAviso++;
        }
    }
}
